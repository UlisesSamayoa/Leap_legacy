@model LEAP.Models.AuthorizationModel
@{
    ViewBag.Title = "Update - Authorization";
}
@if (Model != null)
{
    if (@Model.type == 0)
    {
        <a href="@Url.Action("Index", "Authorization")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
        <br />
        <br />
    }
    else
    {

    }
}

@*<a href="@Url.Action("Index","Authorization")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>*@
@*<br />
    <br />*@
<div class="card">
    @*<form method="post">*@
    <h5 class="card-header bg-dark text-white">Update a Authorization</h5>
    <div class="card-body">
        @Html.AntiForgeryToken()
        <div class="row">
            @if (Model != null)
            {
                if (ViewBag.VB_error != null)
                {
                    <p class="bg-success text-white" style="padding:5px; border-radius:5px;"> Authorization update successfully, reload the list in Consumer</p>
                    <script>
                        setTimeout(() => {
                            window.close()
                        }, 2000);
                    </script>
                }
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="UCI">Consumer Name<b><label id="UCI_N"></label></b></label>
                        @*@Html.TextBoxFor(m => m.UCI, new { @type = "hidden", @class = "form-control", placeholder = "Consumer details", required = "true" })*@
                        @*<input type="hidden" value="@Model.IDAuth" id="IDAuth" />
                            <input type="hidden" value="@Model.UCI" id="UCI" />*@
                        @*@Html.TextBoxFor(m => m.ConsumerName, new { @class = "form-control", placeholder = "Consumer details", required = "true", @readonly = "readonly" })*@
                        <input type="text" value="@Model.ConsumerName" id="ConsumerName" class="form-control" readonly="true" />
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Authorization">Authorization</label>
                        <input type="text" value="@Model.auth" id="AuthNumber" class="form-control" />
                        @*@Html.TextBoxFor(m => m.auth, new { @class = "form-control", placeholder = "Authorization input" })*@
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label>From</label>
                        @if (@Model._From.ToString("yyyy-MM-dd") == "1900-01-01" || @Model._From.ToString("yyyy-MM-dd") == "1901-01-01")
                        {
                            <input type="date" class="form-control" asp-for="_From" id="AuthFrom" name="_From" />
                            @*@Html.TextBoxFor(m => m._From, new { @type = "date", @class = "form-control", @placeholder = "From input"})*@
                        }
                        else
                        {
                            <input type="date" value="@Model._From.ToString("yyyy-MM-dd")" id="AuthFrom" class="form-control" />
                            @*@Html.TextBoxFor(m => m._From, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @placeholder = "From input", @required = "true" })*@
                        }
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label>To</label>
                        @if (@Model._To.ToString("yyyy-MM-dd") == "1900-01-01" || @Model._To.ToString("yyyy-MM-dd") == "1901-01-01")
                        {
                            <input type="date" class="form-control" asp-for="_To" id="AuthTo" name="_To" />
                        }
                        else
                        {
                            <input type="date" value="@Model._To.ToString("yyyy-MM-dd")" id="AuthTo" class="form-control" />
                            @*@Html.TextBoxFor(m => m._To, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @placeholder = "From input" })*@
                        }
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label>Status</label>
                        <select class="form-control" asp-for="estado" id="_AuthEstado" name="estado">
                            @if (@Model.estado == 0)
                            {

                                <option value="1">Enabled</option>
                                <option value="0" selected>Disabled</option>
                            }
                            else
                            {
                                <option value="1" selected>Enabled</option>
                                <option value="0">Disabled</option>

                            }
                        </select>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary text-white" id="AuthAdd"><i class="bi bi-pencil-square"></i> Update</button>

        @if (@Model.type == 1)
        {
            <a onclick="window.close();" class="btn btn-danger text-white"><i class="bi bi-x-square-fill"></i> Cancel</a>
        }
        else
        {
            <a href="@Url.Action("Index","Authorization")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
        }
    </div>
    @*</form>*@
</div>
<script src="~/Scripts/jquery-3.4.1.js"></script>


<script>
    $("#AuthAdd").on("click", function () {
          var _IDAuth = "@Model.IDAuth";
          var _uci = "@Model.UCI";
          var _AuthNumber = $('#AuthNumber').val();
          var _AuthFrom = $('#AuthFrom').val();
          var _AuthTo = $('#AuthTo').val();
          var _estado = $('#_AuthEstado').val();
          if (_AuthNumber == "") {
              _AuthNumber = "N/A"
          }
          if (_AuthFrom == "") {
              _AuthFrom = "1900-01-01"
          }
          if (_AuthTo == "") {
              _AuthTo = "1900-01-01"
          }

        $.ajax({
            type: "POST",
            url: '@Url.Action("UpdateFromConsumer", "Authorization")',
            data: { IDAuth: _IDAuth, UCI: _uci, auth: _AuthNumber, _From: _AuthFrom, _To: _AuthTo, estado: _estado},
            success: function (response) {
                console.log(response)
                if (response == 1) {
                    if ('@Model.type' == '1') {
                       setTimeout(() => {
                        window.close()
                        }, 2000);
                    } else {
                        setTimeout(() => {
                        window.location.href = '@Url.Action("Index", "Authorization")'
                    }, 2000);
                    }

                } else if (response == 0) {
                    $("#ErrorAuthNote").text('¡Error!')
                }
            }
        });
      });
</script>