<div class="card">
    <form asp-action="Add" asp-controller="RegionalCenter" method="post" id="datos">
        <h5 class="card-header bg-dark text-white">Add a Consumer</h5>
        <div class="card-body">
            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label asp-for="Phone">Inf. Taken By.</label>
                        <input type="text" class="form-control" id="inf" asp-for="Phone" placeholder="Inf. Taken By" required>
                    </div>
                </div>
                <div class="col-4">
                    <div class="form-group">
                        <label asp-for="Phone">Action</label>
                        <select id="action" class="form-control">
                            <option value="1">Eval</option>
                            <option value="2" selected>New Consumer Referral</option>
                            <option value="3">Reauthorized Consumer</option>
                            <option value="4">Consumer Terminated</option>
                            <option value="5">Update</option>
                        </select>
                    </div>
                </div>

                <div class="col-4">
                    <div class="form-group">
                        <label asp-for="Phone">Type</label>
                        <select id="type" class="form-control">
                            solo cuando es LEAP
                            <option value="Leap" selected>Leap</option>
                            <!-- <option value="Cent">Center Base</option>-->
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
