        function Getspecialist() {



            $.ajax({
                type: "GET",
                url: 'Getspecialist',
                data: {},
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                success: function (response) {
                    var data = response.split(";");
                    var haa = data.length - 1;
                    var naId = null;
                    for (var i = 0; i < haa; i++) {
                        // Getspecialist() (server) separa cada registro con ";" + salto de
                        // linea, asi que menos el primero, todos los "datos[0]" (ID) traen
                        // un \r\n pegado al inicio. Las comparaciones sueltas con == no lo
                        // notaban (Number("\r\n147") sigue siendo 147), pero $(...).val(naId)
                        // compara el string tal cual contra el atributo value ya parseado
                        // por el navegador (que normaliza el \r\n a \n) - sin el trim(),
                        // nunca hacian match y el select se quedaba en el placeholder.
                        var datos = data[i].split(",").map(item => item.trim());
                        document.getElementById("cds").innerHTML += "<option value='"+datos[0]+"'>" + datos[1] + " " + datos[2] + "</option>";
                        document.getElementById("specialist").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + " " + datos[2] + "</option>";
                        document.getElementById("therapist").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + " " + datos[2] + "</option>";
                        document.getElementById("presenter").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + " " + datos[2] + "</option>";

                        if (naId === null && datos[1] === "N/A") {
                            naId = datos[0];
                        }
                    }

                    // Los 4 selects quedan en el especialista "N/A" real de la BD por
                    // defecto (antes se usaba un placeholder con value="1" que no
                    // corresponde a ningun specialist real - leap_api rechazaba ese ID
                    // con "exists:specialists", lo que hacia parecer que el campo era
                    // obligatorio). Asi nunca se manda null y siempre es un ID valido.
                    if (naId !== null) {
                        $('#cds').val(naId);
                        $('#specialist').val(naId);
                        $('#therapist').val(naId);
                        $('#presenter').val(naId);
                    }
                }
            });
        }

        $('#consumer_image').on('change', function (event) {
            const file = event.target.files[0];
            const validTypes = ['image/png', 'image/jpeg', 'image/webp'];

            if (file && validTypes.includes(file.type)) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#consumer_image_ex').attr('src', e.target.result).show();
                }
                reader.readAsDataURL(file);
            } else {
                alert('Por favor, selecciona una imagen válida (png, jpg, jpeg, webp).');
                $('#consumer_image_ex').hide();
            }
        });


