<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    $(document).ready(function () {


        function applyPhoneMask(event) {
            let input = event.target;
            let value = input.value.replace(/\D/g, '');
            if (value.length <= 3) {
                input.value = `(${value}`;
            } else if (value.length <= 6) {
                input.value = `(${value.substring(0, 3)})-${value.substring(3)}`;
            } else {
                input.value = `(${value.substring(0, 3)})-${value.substring(3, 6)}-${value.substring(6, 10)}`;
            }
        }
        const phoneInput = document.getElementById('phone');
        phoneInput.addEventListener('input', applyPhoneMask);
        const emphoneInput = document.getElementById('emphone');
        emphoneInput.addEventListener('input', applyPhoneMask);



        GetRegional();
        GetCity();
        Getspecialist();
        GetLang();
        function GetRegional() {



            $.ajax({
                type: "GET",
                url: 'GetRegionals',
                data: {},
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                success: function (response) {

                    var data = response.split(";");
                    var haa = data.length - 1;
                    for (var i = 0; i < haa; i++) {
                        var datos = data[i].split(",");
                        document.getElementById("regional").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + "</option>";

                    }

                }
            });
        }
        function GetLang() {



            $.ajax({
                type: "GET",
                url: 'GetLang',
                data: {},
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                success: function (response) {

                    var data = response.split(";");
                    var haa = data.length - 1;
                    for (var i = 0; i < haa; i++) {
                        var datos = data[i].split(",");
