@model LEAP.Models.ConsumerModel
@using Newtonsoft.Json
@{
    ViewBag.Title = "DetailsArchived";
}
<a href="@Url.Action("Archived","Consumer")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<hr />
<br />
@if (Model != null)
{
    <div class="row">
        <div class="col-6 text-right">
            <button type="button" class="btn btn-danger" onclick="ChangeReactiveConsumer()">
                <i class="bi bi-archive-fill"></i> Reactivate consumer
            </button>
        </div>
       
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-12 text-center">
            <img src="data:image/png;base64,@Model.c_image" width="30%" alt="No image" />
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-3">
            <div class="form-group">
                <label asp-label-for="Phone">Inf. Taken By.</label>
                <input type="text" class="form-control" id="inf" asp-for="Phone" placeholder="Phone input" required>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Action</label>
                <select id="action" asp-for="Action" class="form-control">
                    @if (Model.Action == 1)
                    {
                        <option value="1" selected>Eval</option>
                    }
                    else
                    {
                        <option value="1">Eval</option>
                    }
                    @if (Model.Action == 2)
                    {
                        <option value="2" selected>New Consumer Referral</option>
                    }
                    else
                    {
                        <option value="2">New Consumer Referral</option>
                    }
                    @if (Model.Action == 3)
                    {
                        <option value="3" selected>Reauthorized Consumer</option>
                    }
                    else
                    {
                        <option value="3">Reauthorized Consumer</option>
                    }
                    @if (Model.Action == 4)
                    {
                        <option value="4" selected>Consumer Terminated</option>
                    }
                    else
                    {
                        <option value="4">Consumer Terminated</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Ext">Active</label>
                <br />
                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio" id="ActiveY" value="Yes" name="Active" class="custom-control-input" required>
                    <label class="custom-control-label" for="ActiveY">Yes</label>
                </div>
                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio" id="ActiveN" value="female" name="Active" class="custom-control-input" required>
                    <label class="custom-control-label" for="ActiveN">No</label>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Type</label>
                <select id="type" class="form-control">
                    @if (Model.Type == "Center")
                    {
                        <option value="Leap">Leap</option>
                        <option value="Center" selected>Center Base</option>
                    }
                    else
                    {
                        <option value="Leap" selected>Leap</option>
                        <option value="Center">Center Base</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-2">
            <div class="form-group">
                <label asp-for="Ext">UCI</label>
                <input type="text" class="form-control" id="uci" placeholder="Exa:110421" value="@Model.UCI" required>
            </div>
        </div>
        <div class="col-5">
            <div class="form-group">
                <label asp-for="RegionalCenter">Consumer's Name</label>
                <input type="text" class="form-control" id="consumer" placeholder="Enter Name" value="@Model.Name" required>
            </div>
        </div>
        <div class="col-5">
            <div class="form-group">
                <label asp-for="RegionalCenter">Consumer's last Name</label>
                <input type="text" class="form-control" id="lastname" placeholder="Enter last Name" value="@Model.LastName" required>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-3">
            <div class="form-group">
                <label asp-for="DOB">Date Of Birth</label>
                <input type="date" class="form-control" asp-for="DOB" id="dob" value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" required>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Ext">Sex</label>
                <br />
                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio" id="male" value="male" name="sex" class="custom-control-input" required>
                    <label class="custom-control-label" for="male">Male</label>
                </div>
                <div class="custom-control custom-radio custom-control-inline">
                    <input type="radio" id="female" value="female" name="sex" class="custom-control-input" required>
                    <label class="custom-control-label" for="female">Female</label>
                </div>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Telephone</label>
                <input type="text" class="form-control" asp-for="Phone" id="phone" placeholder="(xxx)-xxx-xxxx" value="@Model.Phone" required>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Emergency Tel.</label>
                <input type="text" class="form-control" asp-for="Phone" id="emphone" placeholder="(xxx)-xxx-xxxx" value="@Model.EmergencyPhone" required>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-5">
            <div class="form-group">
                <label asp-for="City">Address</label>
                <input type="text" class="form-control" asp-for="City" id="address" placeholder="Enter address" value="@Model.Address" required>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="State">City</label>
                <select id="city" class="form-control">
                </select>
            </div>
        </div>
        <div class="col-2">
            <div class="form-group">
                <label asp-for="State">State</label>
                <select name="states" id="states" class="form-control">
                    @{
                        string[] states = new string[]
                        {
                            "AL", "AK", "AZ", "AR", "CA", "NC", "SC", "CO", "CT", "ND",
                            "SD", "DE", "DC", "FL", "AA", "AE", "AP", "GA", "HI", "ID",
                            "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI",
                            "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NY", "NM",
                            "OH", "OK", "OR", "PA", "RI", "TN", "TX", "UT", "VT", "VA",
                            "WV", "WA", "WI", "WY"
                        };
                    }
                    @foreach (var estado in states)
                    {
                        <option value="@estado" @(estado == Model.State ? "selected" : "")>@estado</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-2">
            <div class="form-group">
                <label asp-for="State">Zip Code</label>
                <input type="text" class="form-control" id="zipcode" asp-for="State" placeholder="Zip Code" value="@Model.ZipCode" required>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <div class="form-group">
                <label asp-for="Ext">Parent's Name</label>
                <input type="text" class="form-control" id="parent" asp-for="Ext" placeholder="Enter Name" value="@Model.ParentName" required>
            </div>
        </div>
        <div class="col-6">
            <div class="form-group">
                <label asp-for="Ext">Parent's last Name'</label>
                <input type="text" class="form-control" id="parentln" asp-for="Ext" placeholder="Enter last Name" value="@Model.ParentLastName" required>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Ext">Primary Language</label>
                <select id="lang" class="form-control">
                    <option>----- Select a option ------</option>
                </select>
            </div>
        </div>
        <div class="col-2">
            <label asp-for="Ext">Termination #</label>

            <div class="form-group">
                <input type="text" class="form-control" id="termination" asp-for="Ext" placeholder="Ex: 12345" value="@Model.TerminationNumber">
            </div>
        </div>
        <div class="col-7">
            <label asp-for="Ext">Reason for Referral</label>

            <div class="form-group">
                <input type="text" class="form-control" id="reason" asp-for="Ext" placeholder="Reason for referral" value="@Model.Reasonforreferral" required>
            </div>
        </div>
    </div>
    <div class="row">

        <div class="col-12">
            <div class="form-group">
                <label asp-for="Phone">Authorization #</label>
                <input type="text" class="form-control" id="auth" asp-for="Phone" placeholder="Authorization" value="@Model.AuthID" required>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Hours per Week</label>
                <input type="number" id="hours" class="form-control" min="1" step="1" asp-for="Phone" value="@Model.HoursxWeek" required>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Max. Hours per Month</label>
                <input type="number" id="maxhours" class="form-control" asp-for="Phone" min="1" step="1" value="@Model.MaxHours" required>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="TerminationDateEffective">Termination date Effective</label>
                @if (Model.TerminationDateEffective.ToString("yyyy-MM-dd") == "1900-01-01" || Model.TerminationDateEffective.ToString("yyyy-MM-dd") == "1901-01-01")
                {
                    <input type="date" class="form-control" id="terminationdate" asp-for="Phone">
                }
                else
                {
                    <input type="date" class="form-control" id="terminationdate" asp-for="TerminationDateEffective" value="@Model.TerminationDateEffective.ToString("yyyy-MM-dd")" required>
                }
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Additional Eval.</label>

                <select id="addeval" class="form-control">
                    @if (Model.AdditionalEval == "Y")
                    {
                        <option value="Y" selected>Yes</option>
                    }
                    else
                    {
                        <option value="Y">Yes</option>
                    }
                    @if (Model.AdditionalEval == "N")
                    {
                        <option value="N" selected>No</option>
                    }
                    else
                    {
                        <option value="N">No</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-4">
            <div class="form-group">
                <div class="form-check form-check-inline">
                    <label class="form-check-label" for="inlineCheckbox1">In-Home E.I</label>
                    <input class="form-check-input" type="checkbox" id="check1" value="option1" value="@Model.InHome">
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <div class="form-check form-check-inline">
                    <label class="form-check-label" for="inlineCheckbox1">E.I with OT/PT/SLP Consultation</label>
                    <input class="form-check-input" type="checkbox" id="check2" value="option1">
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <div class="form-check form-check-inline">
                    <label class="form-check-label" for="inlineCheckbox1">OT/PT/SLP</label>
                    <input class="form-check-input" type="checkbox" id="check3" value="option1">
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">CDS</label>
                <select id="cds" class="form-control">
                    <option value="1">--------N/A-----------</option>
                </select>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Specialty</label>
                <select id="specialist" class="form-control">
                    <option value="1">--------N/A-----------</option>
                </select>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Therapist</label>
                <select id="therapist" class="form-control">
                    <option value="1">--------N/A-----------</option>
                </select>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label asp-for="Phone">Program Presenter</label>
                <select id="presenter" class="form-control">
                    <option value="1">--------N/A-----------</option>
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="form-group">
                <label asp-for="Ext">Regional</label>
                <select id="regional" class="form-control" onchange="AddressChange();">
                </select>
            </div>
        </div>
        <div class="col-4">
            <div class="form-group">
                <label asp-for="RegionalCenter">Phone</label>
                <input type="text" class="form-control" id="phoneReg" placeholder="State input" disabled>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="form-group">
                <label asp-for="Ext">Address</label>
                <input type="text" class="form-control" id="addressReg" disabled>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-10">
            <div class="form-group">
                <label asp-for="Ext">Service Coordinator</label>
                <input type="text" class="form-control" id="service" placeholder="State input" required>
            </div>
        </div>
        <div class="col-2">
            <div class="form-group">
                <label asp-for="RegionalCenter">Ext</label>
                <input type="text" class="form-control" id="ext" placeholder="State input" required>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-3">
            <div class="form-group">
                <label class="form-check-label" for="inlineCheckbox1"> Evaluation</label>
                <select id="evaluation" class="form-control">
                    @if (Model.evaluation == "Y")
                    {
                        <option value="Y" selected>Yes</option>
                    }
                    else
                    {
                        <option value="Y">Yes</option>
                    }
                    @if (Model.evaluation == "N")
                    {
                        <option value="N" selected>No</option>
                    }
                    else
                    {
                        <option value="N">No</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label class="form-check-label" for="inlineCheckbox1">Initial Eval.</label>
                @if (Model.initEval.ToString("yyyy-MM-dd") == "1900-01-01" || Model.initEval.ToString("yyyy-MM-dd") == "1901-01-01")
                {
                    <input type="date" class="form-control" id="initial" asp-for="Phone">
                }
                else
                {
                    <input type="date" class="form-control" id="initial" asp-for="Phone" placeholder="Phone input" value="@Model.initEval.ToString("yyyy-MM-dd")" required>
                }
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label class="form-check-label" for="inlineCheckbox1">Initial Eval. Due By</label>
                @if (Model.evaldueby.ToString("yyyy-MM-dd") == "1900-01-01" || Model.evaldueby.ToString("yyyy-MM-dd") == "1901-01-01")
                {
                    <input type="date" class="form-control" asp-for="Phone" id="initdue">
                }
                else
                {
                    <input type="date" class="form-control" asp-for="Phone" id="initdue" placeholder="Phone input" value="@Model.evaldueby.ToString("yyyy-MM-dd")" required>
                }
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label class="form-check-label" for="inlineCheckbox1">Closing Report</label>
                @if (Model.ReportClose.ToString("yyyy-MM-dd") == "1900-01-01" || Model.ReportClose.ToString("yyyy-MM-dd") == "1901-01-01")
                {
                    <input type="date" class="form-control" id="closing" asp-for="Phone">
                }
                else
                {
                    <input type="date" class="form-control" id="closing" asp-for="Phone" placeholder="Phone input" value="@Model.ReportClose.ToString("yyyy-MM-dd")" required>
                }
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-3">
            <div class="form-group">
                <label class="form-check-label" for="inlineCheckbox1">1st Progress Report</label>
                @if (Model.Report1.ToString("yyyy-MM-dd") == "1900-01-01" || Model.Report1.ToString("yyyy-MM-dd") == "1901-01-01")
                {
                    <input type="date" class="form-control" id="1st" asp-for="Phone">
                }
                else
                {
                    <input type="date" class="form-control" id="1st" value="@Model.Report1.ToString("yyyy-MM-dd")" asp-for="Phone">
                }
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label class="form-check-label" for="inlineCheckbox1">2nd Progress Report</label>
                @if (Model.Report2.ToString("yyyy-MM-dd") == "1900-01-01" || Model.Report2.ToString("yyyy-MM-dd") == "1901-01-01")
                {
                    <input type="date" class="form-control" id="2nd" asp-for="Phone">
                }
                else
                {
                    <input type="date" class="form-control" id="2nd" value="@Model.Report2.ToString("yyyy-MM-dd")" asp-for="Phone">
                }
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label class="form-check-label" for="inlineCheckbox1">3rd Progress Report</label>
                @if (Model.Report3.ToString("yyyy-MM-dd") == "1900-01-01" || Model.Report3.ToString("yyyy-MM-dd") == "1901-01-01")
                {
                    <input type="date" class="form-control" id="3rd" asp-for="Phone">
                }
                else
                {
                    <input type="date" class="form-control" id="3rd" value="@Model.Report3.ToString("yyyy-MM-dd")" asp-for="Phone">
                }
            </div>
        </div>
        <div class="col-3">
            <div class="form-group">
                <label class="form-check-label" for="inlineCheckbox1">4th Progress Report</label>
                @if (Model.Report4.ToString("yyyy-MM-dd") == "1900-01-01" || Model.Report4.ToString("yyyy-MM-dd") == "1901-01-01")
                {
                    <input type="date" class="form-control" id="4th" asp-for="Phone">
                }
                else
                {
                    <input type="date" class="form-control" id="4th" value="@Model.Report4.ToString("yyyy-MM-dd")" asp-for="Phone">
                }
            </div>
        </div>
    </div>


    <div class="modal fade" id="ModalConsumerNotes" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ModalConsumerNotesLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="ModalConsumerNotesLabel">Add Consumer Note</h5>
                    <button type="button" class="btn-close  text-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12" style="margin-bottom:3px;">
                            <div class="row">
                                <div class="col-12 text-center">
                                    <label class="text-danger" id="ErrorConsumerNote"></label>
                                    <label class="text-danger" id="NotesErrorc"></label>
                                </div>

                                <div class="col-12">
                                    <div class="form-group">
                                        <br />
                                        <label class="form-check-label" for="ConsumerActive">Active</label>
                                        <select asp-for="ConsumerActive" id="ConsumerActive" class="form-control">
                                            <option value="true" selected>Active</option>
                                            <option value="false">Deactive</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group">
                                        <label class="form-check-label" for="ConsumerNote">Consumer Note</label>
                                        <textarea class="form-control" id="ConsumerNote" asp-for="ConsumerNote" placeholder="Consumer Notes" style="max-height:280px; min-height:250px;"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" id="ConsumerNotesAdd"><i class="bi bi-database-fill-add"></i> Create</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="ModalTeacherNotes" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ModalTeacherNotesLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="ModalTeacherNotesLabel">Add Teacher Note</h5>
                    <button type="button" class="btn-close  text-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 text-center">
                            <label class="text-danger" id="ErrorTeacherNote"></label>
                            <label class="text-danger" id="NotesError"></label>
                        </div>
                        <div class="col-4">
                            <div class="form-group">
                                <br />
                                <label class="form-check-label" for="TeacherSpecialist">Specialist</label>
                                <select id="TeacherSpecialist" class="form-control">
                                    <option value="1">--------N/A-----------</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group">
                                <br />
                                <label class="form-check-label" for="TeacherDate">Date</label>
                                <input type="date" class="form-control" id="TeacherDate" placeholder="Date" />
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="form-group">
                                <br />
                                <label class="form-check-label" for="TeacherDuration">Duration</label>
                                <input type="text" class="form-control" id="TeacherDuration" placeholder="Duration" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-check-label" for="TeacherPresentInSession">PresentInSession</label>
                                <input type="text" class="form-control" id="TeacherPresentInSession" placeholder="PresentInSession" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-group">
                                <label class="form-check-label" for="TeacherNote">Consumer Note</label>
                                <textarea class="form-control" id="TeacherNote" asp-for="TeacherNote" placeholder="Teacher Notes" style="max-height:280px; min-height:200px;"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-success" id="TeacherNotesAdd"><i class="bi bi-database-fill-add"></i> Create</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="ModalAuthorization" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="ModalAuthorizationLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-secondary text-white">
                    <h5 class="modal-title" id="ModalAuthorizationLabel">Authorization</h5>
                    <button type="button" class="btn-close  text-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
