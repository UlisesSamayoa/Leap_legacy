@model List<LEAP.Models.ConsumerModel>
@{
    ViewBag.Title = "Consumer";
}
<meta name="viewport" content="width=device-width, initial-scale=1.0">
@*<script src="https://cdn.datatables.net/v/dt/dt-2.0.7/b-3.0.2/datatables.min.js"></script>*@

<style>
    .modal img {
        max-width: 100%;
        height: auto;
    }
</style>
<div class="container">
    <div class="card">
        <h5 class="card-header bg-dark text-white">Consumer</h5>
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                    @if (LEAP.Data.AuthContext.IsAdmin)
                    {
                        <a href="@Url.Action("Add","Consumer")" class="btn btn-success text-white">
                            <i class="bi bi-database-fill-add"></i> New
                        </a>
                    }
                    <hr />
                    <table id="table_regionalCenter" class="table table-hover" style="width:100%">
                        <thead class="thead-dark">
                            <tr>
                                <th>Image</th>
                                <th>UCI</th>
                                <th>Name</th>
                                <th>DOB</th>

                                <th>Parent's Name</th>

                             
                                <th>Phone</th>
                                <th>RC</th>
                                <th>Print</th>
                                <th>See more</th>
                                <th>Update</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null || Model.Count > 0)
                            {
                                foreach (var RCenter in Model)
                                {
                            <tr>
                                <td class="text-center" style="text-align:center;">
                                    @if (!string.IsNullOrEmpty(RCenter.c_image)) // Asegúrate de que la variable no esté vacía
                                    {
                                        <img src="data:image/png;base64,@RCenter.c_image" alt="Imagen" style="max-width: 80px; max-height: 100px; cursor: pointer;"
                                             class="preview-image" data-toggle="modal" data-target="#imageModal" data-image="data:image/png;base64,@RCenter.c_image" />
                                    }
                                    else
                                    {
                                        @*<span>No image</span>*@
                                        <img src="~/Content/Template/user_base.png" width="80px" alt="No image" />
                                    }
                                </td>
                                <td style="text-align:center;">@RCenter.UCI</td>
                                <td style="text-align:center;"> @RCenter.LastName @RCenter.Name </td>
                                <td style="text-align:center;">@RCenter.DateOfBirth.ToString("MM/dd/yyyy")</td>

                                <td style="text-align:center;">@RCenter.ParentName  @RCenter.ParentLastName </td>
                               
                                <td style="text-align:center;">@RCenter.Phone</td>
                             
                                    <td style="text-align:center;">@RCenter.rc</td>
                              
                                <td><a class="btn btn-warning" href="@Url.Action("ConsumerReport","Reports", new { UCI = RCenter.UCI})"><i class="bi bi-printer-fill"></i> Print</a></td>
                                <td>
                                    @if (LEAP.Data.AuthContext.IsAdmin)
                                    {
                                        <a class="btn btn-success" href="@Url.Action("Update","Consumer", new { id = RCenter.IDConsumer})"><i class="bi bi-journal-plus"></i> Read  </a>
                                    }
                                </td>
                                <td>
                                    @if (LEAP.Data.AuthContext.IsAdmin)
                                    {
                                        <a class="btn btn-primary" href="@Url.Action("Update","Consumer", new { id = RCenter.IDConsumer})"><i class="bi bi-pencil-square"></i> Update</a>
                                    }
                                </td>
                                <td>
                                    @if (LEAP.Data.AuthContext.IsAdmin)
                                    {
                                        <a class="btn btn-danger" href="@Url.Action("Delete","Consumer", new { id = RCenter.IDConsumer })"><i class="bi bi-trash-fill"></i> Delete</a>
                                    }
                                </td>
                            </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2">
                                        No data available
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageModalLabel">Preview</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <img id="modal-image" src="" alt="Imagen" />
                </div>
            </div>
        </div>
    </div>



</div>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>

<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
@section scripts {
    <script>
        $(document).ready(function () {
            $('#table_regionalCenter').DataTable({
                "dom": 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>',
                        title: '',
                        filename: 'nombre archivo',
                        exportOptions: { columms: [0] },
                        className: 'btn_excel'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-pdf-fill fs-5"></i>',
                        title: 'Nombre reporte',
                        filename: 'nombre archivo',
                        exportOptions: { columms: [0] },
                        className: 'btn_pdf'
                    }, {
                        extend: 'print',
                        text: '<i class="bi bi-printer-fill fs-5"></i>',
                        title: 'Nombre reporte',
                        filename: 'nombre archivo',
                        exportOptions: { columms: [0] },
                        className: 'btn_print'
                    }
                ]
            });

            $('.preview-image').on('click', function () {
                var imageSrc = $(this).data('image');
                $('#modal-image').attr('src', imageSrc);
            });

        });
    </script>
}
