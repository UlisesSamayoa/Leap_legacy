    function LoadAuthorizationInicial() {
    var _uci = "@Model.UCI";
    $.ajax({
        type: "POST",
        url: '@Url.Action("Auth_byConsumer", "Authorization")',
        data: { id: _uci },
        success: function (response) {
            if (response.length > 0) {
                $('#auth_new').val('')
                $('#auth_from_new').val('')
                $('#auth_to_new').val('')
                $('#auth_status').val('')
                $.each(response, function (index, item) {
                    var _ToBase = moment(item._To).format('MM/DD/YYYY')
                    var _FromBase = moment(item._From).format('MM/DD/YYYY')
                    var _ToCast = ""
                    var _FromCast = ""
                    if (_ToBase.toString() !== "01/01/1900" && _ToBase.toString() !== "01/01/0001") {
                        _ToCast = moment(item._To).format('MM/DD/YYYY')
                    } else {
                        _ToCast = "--/--/--"
                    }
                    if (_FromBase.toString() !== "01/01/1900" && _FromBase.toString() !== "01/01/0001") {
                        _FromCast = moment(item._From).format('MM/DD/YYYY')
                    } else {
                        _FromCast = "--/--/--"
                    }
                    $('#auth_new').val(item.auth)
                    $('#auth_from_new').val(_FromCast)
                    $('#auth_to_new').val(_ToCast)
                    if (item.estado == "0" || item.estado == 0) {
                        $('#auth_status').val("Disabled")
                    } else {
                        $('#auth_status').val("Enabled")
                    }
                    
                });
            } else {
                $('#auth_new').val('')
                $('#auth_from_new').val('')
                $('#auth_to_new').val('')
                $('#auth_status').val('')
            }

        }
    });
    }

    function GetNextConsumerByUCI() {
