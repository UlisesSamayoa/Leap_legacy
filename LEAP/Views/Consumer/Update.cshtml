@model LEAP.Models.ConsumerModel
@using Newtonsoft.Json
@{
        ViewBag.Title = "Update";
        string[] states = new string[]
       {
            "AL", "AK", "AZ", "AR", "CA", "NC", "SC", "CO", "CT", "ND",
            "SD", "DE", "DC", "FL", "AA", "AE", "AP", "GA", "HI", "ID",
            "IL", "IN", "IA", "KS", "KY", "LA", "ME", "MD", "MA", "MI",
            "MN", "MS", "MO", "MT", "NE", "NV", "NH", "NJ", "NY", "NM",
            "OH", "OK", "OR", "PA", "RI", "TN", "TX", "UT", "VT", "VA",
            "WV", "WA", "WI", "WY"
                       };
}

<style>

    .equal-height {
        display: flex;
        flex-direction: column;
    }

    .card-body {
        flex-grow: 1;
    }

    #back-to-top {
        position: fixed;
        bottom: 20px;
        right: 20px;
        display: none; /* Ocultar por defecto */
        background-color: #007BFF;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 10px 20px;
        font-size: 14px;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        #back-to-top:hover {
            background-color: #0056b3;
        }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<div class="row">
    <div class="col-12 text-left">
        <a href="@Url.Action("Index","Consumer")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
    </div>
    <br />
    <hr />
    <div class="row">
        <div class="col-6 text-left">
            <a href="#" id="btn_PrevConsumer" class="btn btn-danger"><i class="bi bi-arrow-left-circle-fill"></i> Previus Consumer </a>
        </div>
        <div class="col-6 text-right">
            <a href="#" id="btn_NextConsumer" class="btn btn-danger">Next Consumer <i class="bi bi-arrow-right-circle-fill"></i></a>
        </div>
    </div>

</div>
<br />
<hr />

@if (Model!= null)
{
<p>
    <div class="row">
        <div class="col-9">
            <button class="btn btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#Div_Consumer" aria-expanded="false" aria-bs-controls="Div_Consumer" id="Div_ConsumerClick">
                <i class="bi bi-journal-bookmark-fill"></i> Consumer Notes
            </button>
            <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#Div_Teacher" aria-expanded="false" aria-bs-controls="Div_Teacher" id="Div_TeacherClick">
                <i class="bi bi-journal-bookmark-fill"></i> Teacher Notes
            </button>
            <button class="btn btn-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#Div_Authorization" aria-expanded="false" aria-bs-controls="Div_Authorization" id="Div_AuthorizationClick">
                <i class="bi bi-check2-circle"></i> Authorization
            </button>
            <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#Div_Image">
                <i class="bi bi-file-earmark-image-fill"></i> Image
            </button>
        </div>
        <div class="col-3">
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#Div_Ready4Archive">
                <i class="bi bi-archive-fill"></i> Ready for archive
            </button>
            <td><a class="btn btn-warning" href="@Url.Action("ConsumerReport","Reports", new { UCI = @Model.UCI})"><i class="bi bi-printer-fill"></i> Print</a></td>
        </div>
    </div>
</p>


<div class="modal fade" id="Div_Ready4Archive" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="Div_Ready4ArchiveLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="Div_Ready4ArchiveLabel">Change consumer status</h5>
                <button type="button" class="btn-close  text-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 text-center">
                        <br />
                        <h5>Are you sure to change the status of the consumer to ready to archive?</h5>
                        <br />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="ChangeR4A()">
                    <i class="bi bi-database-fill-add"></i> Change
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="Div_Image" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="Div_ImageLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="Div_ImageLabel">Change Consumer Image</h5>
                <button type="button" class="btn-close  text-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <div class="form-group">
                            <label class="form-check-label" for="consumer_image">Image</label>
                            <input type="file" class="form-control" id="consumer_image" accept="image/png, image/jpeg, image/webp" />
                        </div>
                    </div>
                    <div class="col-12">
                        <img class="form-control" id="consumer_image_ex" alt="Consumer image" style="height:250px !important; width:100%;" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-dark" onclick="ChangeImage()">
                    <i class="bi bi-database-fill-add"></i> Add
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



<div class="row" style="background:#ccc;">
    @*<div class="col-sm-12 col-md-12 col-lg-12 col-xl-6">*@
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <div class="collapse collapse-horizontal" id="Div_Consumer">
            <div class="card card-body equal-height">
                <div class="row">
                    <div class="col-12 bg-success text-white" style="margin:0 !important; padding-top: 10px !important; padding-bottom: 10px !important; background: #198754; border-radius:5px;">
                        <div class="row">
                            <div class="col-6 text-start">
                                Consumer notes
                            </div>
                            <div class="col-6 text-end">
                                @*<button type="button" id="abrirModal" class="btn btn-outline-light">Add</button>*@
                                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#ModalConsumerNotes">
                                    <i class="bi bi-database-fill-add"></i> Add
                                </button>
                                <button type="button" class="btn btn-danger" onclick="CerrarConsumer()">
                                    <i class="bi bi-x-circle"></i> Close
                                </button>
                            </div>
                        </div>

                    </div>
                    <div class="col-12">
                        <div class="row" style="margin-top:10px;" id="DivAddConsumer">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        @*<div class="col-sm-12 col-md-12 col-lg-12 col-xl-6">*@
        <div class="collapse collapse-horizontal" id="Div_Teacher">
            <div class="card card-body equal-height">
                <div class="row">
                    <div class="col-12 bg-primary text-white" style="margin:0 !important; padding-top: 10px !important; padding-bottom: 10px !important; background: #198754; border-radius:5px;">
                        <div class="row">
                            <div class="col-6 text-start">
                                Teacher notes
                            </div>
                            <div class="col-6 text-end">
                                <button type="button" class="btn btn-danger" onclick="CerrarTeacher()">
                                    <i class="bi bi-x-circle"></i> Close
                                </button>
                            </div>

                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row" style="margin-top:10px;" id="DivAddTeacher">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <div class="collapse collapse-horizontal" id="Div_Authorization">
            <div class="card card-body">
                <div class="row">
                    <div class="col-12 bg-secondary text-white" style="margin:0 !important; padding-top: 10px !important; padding-bottom: 10px !important; background: #198754; border-radius:5px;">
                        <div class="row">
                            <div class="col-6 text-start">
                                Authorization
                            </div>
                            <div class="col-6 text-end">
                                @*<button type="button" id="abrirModal2" class="btn btn-outline-light">Add</button>*@
                                <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#ModalAuthorization">
                                    <i class="bi bi-database-fill-add"></i> Add
                                </button>
                                <button type="button" class="btn btn-danger" onclick="CerrarAuth()">
                                    <i class="bi bi-x-circle"></i> Close
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="row" style="margin-top:10px;" id="DivAddAuth">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<br />
<hr />
<div class="row">
    <div class="col-12 text-center">
        @if (Model.c_image == "")
                    {
        <img src="~/Content/Template/user_base.png" width="150px" alt="No image" />
                    }
                    else
                    {
        <img src="data:image/png;base64,@Model.c_image" width="150px" alt="No image" />
                    }

    </div>
</div>
<br />
<div class="row">
    <div class="col-4">
        <div class="form-group">
            <label asp-label-for="Phone">Inf. Taken By.</label>
            <input type="text" class="form-control" id="inf" value="@Model.UserC" asp-for="UserC" placeholder="Inf. Taken By" required>
        </div>
    </div>
    <div class="col-4">
        <div class="form-group">
            <label asp-for="Phone">Action</label>
            <select id="action" asp-for="Action" class="form-control">
                @if (@Model.Action == 1)
                {
                    <option value="1" selected>Eval</option>
                }
                else
                {
                    <option value="1">Eval</option>
                }
                @if (@Model.Action == 2)
                {
                    <option value="2" selected>New Consumer Referral</option>
                }
                else
                {
                    <option value="2">New Consumer Referral</option>
                }
                @if (@Model.Action == 3)
                {
                    <option value="3" selected>Reauthorized Consumer</option>
                }
                else
                {
                    <option value="3">Reauthorized Consumer</option>
                }
                @if (@Model.Action == 4)
                {
                    <option value="4" selected>Consumer Terminated</option>
                }
                else
                {
                    <option value="4">Consumer Terminated</option>
                }
                @if (@Model.Action == 5)
                {
                    <option value="5" selected>Update</option>
                }
                else
                {
                    <option value="5">Update</option>
                }
            </select>
        </div>
    </div>
