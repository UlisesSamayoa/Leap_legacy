    function GetLang() {
         var _base_languaje = @Html.Raw(JsonConvert.SerializeObject(Model.LanguajeID));
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetLang", "Consumer")',
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            success: function (response) {
                var data = response.split(";");
                var haa = data.length - 1;
                for (var i = 0; i < haa; i++) {
                    /*var datos = data[i].split(",");*/
                    var datos = data[i].split(",").map(item => item.trim());
                    if (_base_languaje == datos[0]) {
                        document.getElementById("lang").innerHTML += "<option value='" + datos[0] + "' selected>" + datos[1] + "</option>";
                    } else {
                        document.getElementById("lang").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + "</option>";
                    }
                }
            }
        });
    }

