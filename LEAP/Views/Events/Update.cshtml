@model LEAP.Models.EventsModel
@{
    ViewBag.Title = "Update - Events";
}
<style>
    .expandable-textarea {
        width: 100%;
        min-height: 300px;
        overflow: hidden;
        resize: vertical;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 7px;
        padding: 8px;
    }

        .expandable-textarea:focus {
            outline: none;
            border-color: #ccc;
            box-shadow: 0 0 5px rgba(102, 175, 233, 0.6);
        }
</style>
<a href="@Url.Action("Index","Events")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<br />
<div class="card">
    <form asp-action="Update" asp-controller="Events" method="post">
        <h5 class="card-header bg-dark text-white">Update a Event</h5>

        @Html.AntiForgeryToken()

        @if (ViewBag.VB_error != null)
        {
            <div class="row">
                <div class="col-12 text-center">
                    <br />
                    <label class="text-danger">@ViewBag.VB_error</label>
                    <br /><br />
                </div>
            </div>
        }
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="Title">Title</label>
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Title input", required = "true" })
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-group">
                        <label asp-for="DateEvent">Date</label>
                        @Html.TextBoxFor(m => m.DateEvent, "{0:yyyy-MM-dd HH:mm}", new { @type = "datetime-local", @class = "form-control", placeholder = "Date input", required = "true" })
                    </div>
                </div>
                <div class="col-9">
                    <div class="form-group">
                        <label asp-for="Description">Description</label>
                        @Html.TextBoxFor(m => m.Description, new { @class = "form-control", placeholder = "Description input", required = "true" })
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <label asp-for="IDType">EventType</label>
                        @Html.DropDownListFor(m => m.IDType, ViewBag.VB_EventType as List<SelectListItem>, " -- Select Type --", new { @class = "form-control", required = "true" })
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-primary text-white" type="submit"><i class="bi bi-pencil-square"></i> Update</button>
            <a href="@Url.Action("Index","Events")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
        </div>

    </form>
</div>
<script src="~/Scripts/jquery-3.4.1.js"></script>

