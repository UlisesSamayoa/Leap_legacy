@{
    ViewBag.Title = "Home Page";
}

<!DOCTYPE html>
<html>
<head>
    <style>
        div.gallery {
            border: 1px solid #ccc;
        }

            div.gallery:hover {
                border: 1px solid #777;
            }

            div.gallery img {
                width: 100%;
                height: auto;
            }

        div.desc {
            padding: 15px;
            text-align: center;
        }

        * {
            box-sizing: border-box;
        }

        .responsive {
            padding: 0 6px;
            float: left;
            width: 24.99999%;
        }


        .clearfix:after {
            content: "";
            display: table;
            clear: both;
        }
    </style>
</head>
<body>
    <h1 style="text-align:center">LEAP FOR INFANTS - HOME</h1>
    <br />

    <div class="responsive">
        <div class="gallery">
            <a target="_blank" href="#">
                <img src="~/Content/Template/1.jpg" alt="Cinque Terre" width="600" height="400">
            </a>
            <div class="desc">&nbsp;</div>
        </div>
    </div>


    <div class="responsive">
        <div class="gallery">
            <a target="_blank" href="#">
                <img src="~/Content/Template/2.jpg" alt="Forest" width="600" height="400">
            </a>
