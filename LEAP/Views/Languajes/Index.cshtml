@model List<LEAP.Models.LanguajesModel>
@{
    ViewBag.Title = "Languajes";
}
<div class="card">
    <h5 class="card-header bg-dark text-white">Languajes</h5>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                @if (LEAP.Data.AuthContext.IsAdmin)
                {
                    <a href="@Url.Action("Add","Languajes")" class="btn btn-success text-white">
                        <i class="bi bi-database-fill-add"></i> New
                    </a>
                }
                <hr />
                <table id="table_languages" class="table table-hover" style="width:100%">
                    <thead class="thead-dark">
                        <tr>
                            <th>Languaje</th>
                            @*<th>Coordinator</th>*@
                            <th>Notes</th>
                            <th>Update</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null || Model.Count > 0)
                        {
                            foreach (var Languaje in Model)
                            {
                                <tr>
                                    <td>@Languaje.Languaje</td>
                                    <td>@Languaje.Notes</td>
                                    <td>
                                        @if (LEAP.Data.AuthContext.IsAdmin)
                                        {
                                            <a class="btn btn-outline-primary" href="@Url.Action("Update","Languajes", new { id = Languaje.IDLanguaje })"><i class="bi bi-pencil-square"></i> Update</a>
                                        }
                                    </td>
                                    <td>
                                        @if (LEAP.Data.AuthContext.IsAdmin)
                                        {
                                            <a class="btn btn-outline-danger" href="@Url.Action("Delete","Languajes", new { id = Languaje.IDLanguaje })"><i class="bi bi-trash-fill"></i> Delete</a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2">
                                    No data available
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script>
        $(document).ready(function () {
            $('#table_languajes').DataTable({
                "dom": 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>',
                        title: 'Languajes',
                        filename: 'rpt_languajes',
                        exportOptions: { columns: [0, 1] },
                        className: 'btn_excel'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-pdf-fill fs-5"></i>',
                        title: 'Languajes',
                        filename: 'rpt_languajes',
                        exportOptions: { columns: [0, 1] },
                        className: 'btn_pdf'
                    }, {
                        extend: 'print',
                        text: '<i class="bi bi-printer-fill fs-5"></i>',
                        title: 'Languajes',
                        filename: 'rpt_languajes',
                        exportOptions: { columns: [0, 1] },
                        className: 'btn_print'
                    }
                ]
            });
        });
    </script>
}
