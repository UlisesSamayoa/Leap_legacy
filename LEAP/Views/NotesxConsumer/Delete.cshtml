@model LEAP.Models.NotesxConsumerModel
@{
    ViewBag.Title = "Delete - NotesxConsumer";
}
<style>
    .formatted-text {
        white-space: pre-line;
        background: #b6b6b6;
        border-radius: 5px;
        padding: 20px;
    }
</style>
@if (Model != null)
{
    if (Model.type == 0)
    {
        <a href="@Url.Action("Index","NotesxConsumer")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
        <br />
        <br />
    }
    else
    {

    }
}

<div class="card">
    @if (Model != null)
    {
        <form asp-action="Delete" asp-controller="NotesxConsumer" asp-route-lg="@Model.IDNotesxConsumer" method="post">
            @Html.AntiForgeryToken()
            <h5 class="card-header bg-dark text-white">Delete a NotesxConsumer</h5>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 text-center alert alert-danger">
                        Are you sure you want to delete the Note for the Consumer with UCI: @Model.UCI and Name: @Model.ConsumerName?
                        @Html.TextBoxFor(m => m.type, new { @type = "hidden", @class = "form-control", placeholder = "Type" })
                    </div>
                    <div class="col-12">
                        <label>*********Note Details</label><br />
                        <label class="formatted-text" style="width:100%;">@Model.Notes</label>
                    </div>
                    @if (ViewBag.VB_error != null)
                    {
                        <p class="bg-success text-white" style="padding:5px; border-radius:5px;"> Note delete successfully, reload the list in Consumer</p>
                        <script>
                            setTimeout(() => {
                                window.close()
                            }, 2000);
                        </script>
                    }
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-warning " type="submit"><i class="bi bi-trash-fill"></i> Delete</button>
                @if (Model.type == 0)
                {
                    <a href="@Url.Action("Index","NotesxConsumer")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
                }
                else
                {
                    <a onclick="window.close();" class="btn btn-danger text-white"><i class="bi bi-x-square-fill"></i> Cancel</a>
                }
            </div>
        </form>
    }
    else
    {
        <h3 class="text-danger">¡ERROR!</h3>
    }
</div>