@{
    ViewBag.Title = "NotesxConsumer";
}
<div class="card">
    <h5 class="card-header bg-dark text-white">NotesXConsumer</h5>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                @if (LEAP.Data.AuthContext.IsAdmin)
                {
                    <a href="@Url.Action("Add","NotesxConsumer")" class="btn btn-success text-white">
                        <i class="bi bi-database-fill-add"></i> New
                    </a>
                }
                <hr />
                <table id="table_NotesC" class="table table-hover" style="width:100%">
                    <thead class="thead-dark">
                        <tr>
                            <th>UCI</th>
                            <th>ConsumerName</th>
                            <th>Notes</th>
                            <th>Active</th>
                            <th>Date</th>
                            <th>Details</th>
                            <th>Update</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>

<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
@section scripts {
    <script>
        // Plantillas de URL resueltas por Razor (respetan el virtual
        // directory/base path de la app) - __ID__ se reemplaza por el ID real
        // de cada fila al pintar los botones de accion.
        var detailsUrlTemplate = '@Url.Action("Details", "NotesxConsumer", new { id = "__ID__", type = 0 })';
        var updateUrlTemplate = '@Url.Action("Update", "NotesxConsumer", new { id = "__ID__", type = 0 })';
        var deleteUrlTemplate = '@Url.Action("Delete", "NotesxConsumer", new { id = "__ID__", type = 0 })';
        var isAdmin = @Html.Raw(Json.Encode(LEAP.Data.AuthContext.IsAdmin));

        $(document).ready(function () {
            // Vuelve a client-side processing: leap_api ya filtra este listado a
            // solo consumers Active (~3% de las 33k+ notas originales), asi que
            // traer todo de una es rapido de nuevo. DataTables busca/ordena/pagina
            // en el navegador, igual que el comportamiento original. Los botones
            // de Excel/PDF/Print vuelven a exportar todo lo filtrado, no solo la
            // pagina visible.
            $('#table_NotesC').DataTable({
                "dom": 'Bfrtip',
                pageLength: 25,
                order: [[4, 'desc']],
                ajax: {
                    url: '@Url.Action("GetAll", "NotesxConsumer")',
                    dataSrc: ''
                },
                columns: [
                    { data: 'UCI' },
                    { data: 'ConsumerName' },
                    { data: 'Notes' },
                    { data: 'Active' },
                    { data: 'DateC' },
                    {
                        data: null, orderable: false, searchable: false,
                        render: function (row) {
                            var url = detailsUrlTemplate.replace('__ID__', row.IDNotesxConsumer);
                            return '<a class="btn btn-outline-success" href="' + url + '"><i class="bi bi-eye-fill"></i> See_More</a>';
                        }
                    },
                    {
                        data: null, orderable: false, searchable: false,
                        render: function (row) {
                            if (!isAdmin) return '';
                            var url = updateUrlTemplate.replace('__ID__', row.IDNotesxConsumer);
                            return '<a class="btn btn-outline-primary" href="' + url + '"><i class="bi bi-pencil-square"></i> Update</a>';
                        }
                    },
                    {
                        data: null, orderable: false, searchable: false,
                        render: function (row) {
                            if (!isAdmin) return '';
                            var url = deleteUrlTemplate.replace('__ID__', row.IDNotesxConsumer);
                            return '<a class="btn btn-outline-danger" href="' + url + '"><i class="bi bi-trash-fill"></i> Delete</a>';
                        }
                    }
                ],
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>',
                        title: 'NotesXConsumer',
                        filename: 'rpt_NotesXConsumer',
                        exportOptions: { columns: [0, 1, 2, 3] },
                        className: 'btn_excel'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-pdf-fill fs-5"></i>',
                        title: 'NotesXConsumer',
                        filename: 'rpt_NotesXConsumer',
                        exportOptions: { columns: [0, 1, 2, 3] },
                        className: 'btn_pdf'
                    }, {
                        extend: 'print',
                        text: '<i class="bi bi-printer-fill fs-5"></i>',
                        title: 'NotesXConsumer',
                        filename: 'rpt_NotesXConsumer',
                        exportOptions: { columns: [0, 1, 2, 3] },
                        className: 'btn_print'
                    }
                ]
            });
        });
    </script>
}
