@model List<LEAP.Models.NotesxConsumerModel>
@{
    ViewBag.Title = "NotesxConsumer";
}
<div class="card">
    <h5 class="card-header bg-dark text-white">NotesXConsumer</h5>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <a href="@Url.Action("Add","NotesxConsumer")" class="btn btn-success text-white">
                    <i class="bi bi-database-fill-add"></i> New
                </a>
                <hr />
                <table id="table_NotesC" class="table table-hover" style="width:100%">
                    <thead class="thead-dark">
                        <tr>
                            <th>UCI</th>
                            <th>ConsumerName</th>
                            @*<th>Coordinator</th>*@
                            <th>Notes</th>
                            <th>Active</th>
                            <th>Date</th>
                            <th>Details</th>
                            <th>Update</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null || Model.Count > 0)
                        {
                            foreach (var NotesConsumer in Model.OrderByDescending(n => n.DateC))
                            {
                                <tr>
                                    <td>@NotesConsumer.UCI</td>
                                    <td>@NotesConsumer.ConsumerName</td>
                                    @if (NotesConsumer.Notes.Length >= 100)
                                    {
                                        <td>@NotesConsumer.Notes.Substring(0, 100)...</td>
                                    }
                                    else
                                    {
                                        <td>@NotesConsumer.Notes</td>
                                    }

                                    <td>@NotesConsumer.Active</td>
                                    <td>@(NotesConsumer.DateC.HasValue ? NotesConsumer.DateC.Value.ToString("MM/dd/yyyy") : "")</td>
                                    <td>
                                        <a class="btn btn-outline-success" href="@Url.Action("Details","NotesxConsumer", new { id = NotesConsumer.IDNotesxConsumer, type = 0 })"><i class="bi bi-eye-fill"></i> See_More</a>
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-primary" href="@Url.Action("Update","NotesxConsumer", new { id = NotesConsumer.IDNotesxConsumer, type = 0  })"><i class="bi bi-pencil-square"></i> Update</a>
                                    </td>
                                    <td>
                                        <a class="btn btn-outline-danger" href="@Url.Action("Delete","NotesxConsumer", new { id = NotesConsumer.IDNotesxConsumer, type = 0  })"><i class="bi bi-trash-fill"></i> Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2">
                                    No data available
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>

<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
@section scripts {
    <script>
        $(document).ready(function () {
            $('#table_NotesC').DataTable({
                "dom": 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>',
                        title: 'NotesXConsumer',
                        filename: 'rpt_NotesXConsumer',
                        exportOptions: { columns: [0, 1, 2, 3] },
                        className: 'btn_excel'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-pdf-fill fs-5"></i>',
                        title: 'NotesXConsumer',
                        filename: 'rpt_NotesXConsumer',
                        exportOptions: { columns: [0, 1, 2, 3] },
                        className: 'btn_pdf'
                    }, {
                        extend: 'print',
                        text: '<i class="bi bi-printer-fill fs-5"></i>',
                        title: 'NotesXConsumer',
                        filename: 'rpt_NotesXConsumer',
                        exportOptions: { columns: [0, 1, 2, 3] },
                        className: 'btn_print'
                    }
                ]
            });
        });
    </script>
}
