@model List<LEAP.Models.NotesxMaestroModel>
@{
    ViewBag.Title = "NotesxMaestro";
}
<div class="card">
    <h5 class="card-header bg-dark text-white">Notes x Teacher</h5>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <p class="text-muted"><i class="bi bi-info-circle"></i> New visits are logged from the leap_client app by the CDS. This screen is for review/edit/delete only.</p>
                <hr />
                <table id="table_NotesM" class="table table-hover" style="width:100%">
                    <thead class="thead-dark">
                        <tr>
                            <th>UCI</th>
                            <th>ConsumerName</th>
                            <th>RegionalCenter</th>
                            <th>Date&Hour</th>
                            <th>Duration</th>
                            <th>SpecialitName</th>
                            @*<th>Coordinator</th>*@
                            <th>Details</th>
                            <th>Update</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null || Model.Count > 0)
                        {
                            foreach (var NotesMaestro in Model)
                            {
                        <tr>
                            <td>@NotesMaestro.UCI</td>
                            <td>@NotesMaestro.ConsumerName</td>
                            <td>@NotesMaestro.RegionalName</td>
                            <td>@NotesMaestro.Date</td>
                            <td>@NotesMaestro.Duration</td>
                            <td>@NotesMaestro.SpecialitName</td>
                            <td>
                                <a class="btn btn-outline-success" href="@Url.Action("Details","NotesxMaestro", new { id = NotesMaestro.IDNotesxMaestro, type = 0 })"><i class="bi bi-eye-fill"></i> See_More</a>
                            </td>
                            <td>
                                <a class="btn btn-outline-primary" href="@Url.Action("Update","NotesxMaestro", new { id = NotesMaestro.IDNotesxMaestro, type = 0 })"><i class="bi bi-pencil-square"></i> Update</a>
                            </td>
                            <td>
                                <a class="btn btn-outline-danger" href="@Url.Action("Delete","NotesxMaestro", new { id = NotesMaestro.IDNotesxMaestro, type = 0 })"><i class="bi bi-trash-fill"></i> Delete</a>
                            </td>
                        </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2">
                                    No data available
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script>
        $(document).ready(function () {
            $('#table_NotesM').DataTable({
                "dom": 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>',
                        title: 'NotesXMaestro',
                        filename: 'rpt_notesxmaestro',
                        exportOptions: { columns: [0, 1,2,3,4,5] },
                        className: 'btn_excel'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-pdf-fill fs-5"></i>',
                        title: 'NotesXMaestro',
                        filename: 'rpt_notesxmaestro',
                        exportOptions: { columns: [0, 1, 2, 3, 4, 5] },
                        className: 'btn_pdf'
                    }, {
                        extend: 'print',
                        text: '<i class="bi bi-printer-fill fs-5"></i>',
                        title: 'NotesXMaestro',
                        filename: 'rpt_notesxmaestro',
                        exportOptions: { columns: [0, 1, 2, 3, 4, 5] },
                        className: 'btn_print'
                    }
                ]
            });
        });
    </script>
}
