@model LEAP.Models.NotesxMaestroModel
@{
    ViewBag.Title = "Update - NotesxMaestro";
}
<style>
    .expandable-textarea {
        width: 100%;
        min-height: 300px;
        overflow: hidden;
        resize: vertical;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 7px;
        padding: 8px;
    }

        .expandable-textarea:focus {
            outline: none;
            border-color: #ccc;
            box-shadow: 0 0 5px rgba(102, 175, 233, 0.6);
        }
</style>
@if (Model != null)
{
    if (Model.type == 0)
    {
        <a href="@Url.Action("Index","NotesxMaestro")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
        <br />
        <br />
    }
    <div class="card">
        <form asp-action="Update" asp-controller="NotesxMaestro" method="post">
            <h5 class="card-header bg-dark text-white">Update a NotesxMaestro</h5>

            @Html.AntiForgeryToken()

            @if (ViewBag.VB_error != null)
            {
                <p class="bg-success text-white" style="padding:5px; border-radius:5px;"> Note update successfully, reload the list in Consumer</p>
                <script>
                    setTimeout(() => {
                        window.close()
                    }, 2000);
                </script>
            }
            <div class="card-body">
                <div class="row">
                    <div class="col-4">
                        <div class="form-group">
                            <label asp-for="UCI">Consumer Name</label>
                            @Html.TextBoxFor(m => m.type, new { @type = "hidden", @class = "form-control", placeholder = "Type" })
                            @Html.HiddenFor(m => m.Signature)
                            @Html.TextBoxFor(m => m.ConsumerName, new { @class = "form-control", placeholder = "Consumer details", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-group">
                            <label asp-for="SpecialitName">Specialist</label>
                            @Html.TextBoxFor(m => m.SpecialitName, new { @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="form-group">
                            <label asp-for="Duration">Duration</label>
                            @Html.TextBoxFor(m => m.Duration, new { @type = "text", @class = "form-control", @readonly = "readonly" })
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="form-group">
                            <label asp-for="TimesxWeek">Times/wk</label>
                            @Html.TextBoxFor(m => m.TimesxWeek, new { @type = "text", @class = "form-control", placeholder = "e.g. 2x/wk", required = "true" })
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="form-group">
                            <label asp-for="Date">Arrival</label>
                            @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd HH:mm}", new { @type = "datetime-local", @class = "form-control", @required = "true" })
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label asp-for="DepartureDate">Departure</label>
                            @Html.TextBoxFor(m => m.DepartureDate, "{0:yyyy-MM-dd HH:mm}", new { @type = "datetime-local", @class = "form-control", @required = "true" })
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-group">
                            <label asp-for="PresentInSession">PresentInSession</label>
                            @Html.TextBoxFor(m => m.PresentInSession, new { @class = "form-control", placeholder = "PresentInSession input", required = "true" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label asp-for="Notes">Notes</label>
                            @Html.TextAreaFor(m => m.Notes, new { @class = "expandable-textarea", placeholder = "Notes input", required = "true" })
                        </div>
                    </div>
                    <div class="col-12">
                        <label>Parent/guardian signature</label>
                        <div>
                            @if (!string.IsNullOrEmpty(Model.Signature))
                            {
                                <img src="@Model.Signature" alt="Signature" style="max-height:160px;border:1px solid #ccc;border-radius:7px;" />
                            }
                            else
                            {
                                <p class="text-muted">No signature captured.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary text-white" type="submit"><i class="bi bi-pencil-square"></i> Update</button>
                @if (Model.type == 0)
                {
                    <a href="@Url.Action("Index","NotesxMaestro")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
                }
                else
                {
                    <a onclick="window.close();" class="btn btn-danger text-white"><i class="bi bi-x-square-fill"></i> Cancel</a>
                }
            </div>

        </form>
    </div>
}
else
{
    <h3 class="text-danger">¡ERROR!</h3>
}
<script src="~/Scripts/jquery-3.4.1.js"></script>

