@model LEAP.Models.NotesxMaestroModel
@{
    ViewBag.Title = "Update - NotesxMaestro";
}
<style>
    .expandable-textarea {
        width: 100%;
        min-height: 300px;
        overflow: hidden;
        resize: vertical;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 7px;
        padding: 8px;
    }

        .expandable-textarea:focus {
            outline: none;
            border-color: #ccc;
            box-shadow: 0 0 5px rgba(102, 175, 233, 0.6);
        }
</style>
@if (Model != null)
{
    if (Model.type == 0)
    {
        <a href="@Url.Action("Index","NotesxMaestro")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
        <br />
        <br />
    }
    <div class="card">
        <form asp-action="Update" asp-controller="NotesxMaestro" method="post">
            <h5 class="card-header bg-dark text-white">Update a NotesxMaestro</h5>

            @Html.AntiForgeryToken()

            @if (ViewBag.VB_error != null)
            {
                <p class="bg-success text-white" style="padding:5px; border-radius:5px;"> Note update successfully, reload the list in Consumer</p>
                <script>
                    setTimeout(() => {
                        window.close()
                    }, 2000);
                </script>
            }
            <div class="card-body">
                <div class="row">
                    <div class="col-4">
                        <div class="form-group">
                            <label asp-for="UCI">Consumer Name <b><label id="UCI_N"></label></b></label>
                            @*@Html.DropDownListFor(m => m.UCI, ViewBag.VB_Consumer as List<SelectListItem>, " -- Select Consumer --", new { @class = "form-control", required = "true" })*@

                            @Html.TextBoxFor(m => m.UCI, new { @type = "hidden", @class = "form-control", placeholder = "Consumer details", required = "true" })
                            @Html.TextBoxFor(m => m.type, new { @type = "hidden", @class = "form-control", placeholder = "Type" })
                            @Html.TextBoxFor(m => m.ConsumerName, new { @class = "form-control", placeholder = "Consumer details", required = "true", @readonly = "readonly" })
                        </div>
                    </div>
                    @*<div class="col-4">
                    <div class="form-group">
                        <label asp-for="UCI">Comsumer</label>
                        @Html.DropDownListFor(m => m.UCI, ViewBag.VB_Consumer as List<SelectListItem>, " -- Select Consumer --", new { @class = "form-control", required = "true" })
                    </div>
                </div>*@
                    @*<div class="col-4">
                    <div class="form-group">
                        <label asp-for="RegionalID">Regional Center</label>
                        @Html.DropDownListFor(m => m.RegionalID, ViewBag.VB_RegionalCenter as List<SelectListItem>, " -- Select Center --", new { @class = "form-control", required = "true" })
                    </div>
                </div>*@

                    <div class="col-3">
                        <div class="form-group">
                            <label asp-for="SpecialitID">Specialist</label>
                            @Html.DropDownListFor(m => m.SpecialitID, ViewBag.VB_Specialist as List<SelectListItem>, " -- Select Specialist --", new { @class = "form-control", required = "true" })
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-group">
                            <label asp-for="Date">Date</label>
                            @*@Html.TextBoxFor(m => m.Date, new { @type = "datetime-local", @class = "form-control", placeholder = "Date input", required = "true" })*@
                            @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd HH:mm}", new { @type = "datetime-local", @class = "form-control", @placeholder = "Date input", @required = "true" })
                        </div>
                    </div>
                    @*Posible 2 o 3 en times, duration y total*@
                    @*<div class="col-2">
                    <div class="form-group">
                        <label asp-for="TimesxWeek">TimesxWeek</label>
                        @Html.TextBoxFor(m => m.TimesxWeek, new { @type = "text", @class = "form-control", placeholder = "TimesxWeek", required = "true" })
                    </div>
                </div>*@
                    <div class="col-2">
                        <div class="form-group">
                            <label asp-for="Duration">Duration</label>
                            @Html.TextBoxFor(m => m.Duration, new { @type = "text", @class = "form-control", placeholder = "Duration", required = "true" })
                        </div>
                    </div>
                    @*<div class="col-2">
                    <div class="form-group">
                        <label asp-for="TotalHours">TotalHours</label>
                        @Html.TextBoxFor(m => m.TotalHours, new { @type = "text", @class = "form-control", placeholder = "TotalHours", required = "true" })
                    </div>
                </div>*@

                    <div class="col-12">
                        <div class="form-group">
                            <label asp-for="PresentInSession">PresentInSession</label>
                            @Html.TextBoxFor(m => m.PresentInSession, new { @class = "form-control", placeholder = "PresentInSession input", required = "true" })
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-group">
                            <label asp-for="Notes">Notes</label>
                            @Html.TextAreaFor(m => m.Notes, new { @class = "expandable-textarea", placeholder = "Notes input", required = "true" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary text-white" type="submit"><i class="bi bi-pencil-square"></i> Update</button>
                @if (Model.type == 0)
                {
                    <a href="@Url.Action("Index","NotesxMaestro")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
                }
                else
                {
                    <a onclick="window.close();" class="btn btn-danger text-white"><i class="bi bi-x-square-fill"></i> Cancel</a>
                }
            </div>

        </form>
    </div>
}
else
{
    <h3 class="text-danger">¡ERROR!</h3>
}
<script src="~/Scripts/jquery-3.4.1.js"></script>

