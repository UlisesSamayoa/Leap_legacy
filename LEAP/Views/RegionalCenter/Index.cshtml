@model List<LEAP.Models.RegionalCenterModel>
@{
    ViewBag.Title = "RegionalCenter";
}
@*<script src="https://cdn.datatables.net/v/dt/dt-2.0.7/b-3.0.2/datatables.min.js"></script>*@

    <div class="card">
        <h5 class="card-header bg-dark text-white">Regional Center</h5>
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                    @if (LEAP.Data.AuthContext.IsAdmin)
                    {
                        <a href="@Url.Action("Add","RegionalCenter")" class="btn btn-success text-white">
                            <i class="bi bi-database-fill-add"></i> New
                        </a>
                    }
                    <hr />
                    <table id="table_regionalCenter" class="table table-hover" style="width:100%">
                        <thead class="thead-dark">
                            <tr>
                                <th>RegionalCenter</th>
                                @*<th>Coordinator</th>*@
                                <th>Phone</th>
                                <th>Address</th>
                                <th>City</th>
                                <th>State</th>
                                <th>ZipCode</th>
                                <th>Ext</th>
                                <th>Update</th>
                                <th>Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var RCenter in Model)
                                {
                            <tr>
                                <td>@RCenter.RegionalCenter</td>
                                <td>@RCenter.Phone</td>
                                <td>@RCenter.Address</td>
                                <td>@RCenter.City</td>
                                <td>@RCenter.State</td>
                                <td>@RCenter.ZipCode</td>
                                <td>@RCenter.Ext</td>
                                
                                <td>
                                    @if (LEAP.Data.AuthContext.IsAdmin)
                                    {
                                        <a class="btn btn-outline-primary" href="@Url.Action("Update","RegionalCenter", new { id = RCenter.IDRegionalCenter })"><i class="bi bi-pencil-square"></i> Update</a>
                                    }
                                </td>
                                <td>
                                    @if (LEAP.Data.AuthContext.IsAdmin)
                                    {
                                        <a class="btn btn-outline-danger" href="@Url.Action("Delete","RegionalCenter", new { id = RCenter.IDRegionalCenter })"><i class="bi bi-trash-fill"></i> Delete</a>
                                    }
                                </td>
                            </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2">
                                        No data available
                                    </td>
                                </tr>

                            }
                        </tbody>
                        <!--<tfoot class="table-dark">
                            <tr>
                                <th>RegionalCenter</th>-->
                                @*<th>Coordinator</th>*@
                                <!--<th>Phone</th>
                                <th>Address</th>
                                <th>City</th>
                                <th>State</th>
                                <th>ZipCode</th>
                                <th>Ext</th>
                                <th>Update</th>
                                <th>Delete</th>
                            </tr>
                        </tfoot>-->
                    </table>
                </div>
            </div>
        </div>
    </div>
    

@section scripts {
    <script>
        $(document).ready(function () {
            $('#table_regionalCenter').DataTable({
                "dom": 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>',
                        title: 'Regional Center',
                        filename: 'rpt_regionalcenter',
                        exportOptions: { columns: [0, 1, 2, 3, 4,5,6] },
                        className: 'btn_excel'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-pdf-fill fs-5"></i>',
                        title: 'Regional Center',
                        filename: 'rpt_regionalcenter',
                        exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] },
                        className: 'btn_pdf'
                    }, {
                        extend: 'print',
                        text: '<i class="bi bi-printer-fill fs-5"></i>',
                        title: 'Regional Center',
                        filename: 'rpt_regionalcenter',
                        exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] },
                        className: 'btn_print'
                    }
                ]
            });
        });
    </script>
}