    function AsignarUCI(input, valor) {
        $("#"+input).val(valor)
    };

    $('#btn_clear').click(function () {
        $('#searchBox').val(''); // Limpiar el campo de búsqueda
        $('#resultList').empty(); // Limpiar los resultados de la búsqueda
        $('#btn_clear').hide(); // Ocultar el botón Clear
    });
    function Prueba() {
        $('#searchBox').val(''); // Limpiar el campo de búsqueda
        $('#btn_clear').hide(); // Ocultar el botón Clear
