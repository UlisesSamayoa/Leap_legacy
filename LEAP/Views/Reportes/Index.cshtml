<script>
    $(document).ready(function () {
        $('#btn_clear').hide();
            $('#searchBox').on('keyup', function() {
                var query = $('#searchBox').val();
                if (query.length > 0) {
                    $('#btn_clear').show();
                } else {
                    $('#btn_clear').hide();
                }
                var baseUrl = '@Url.Action("Consumer_Report", "Reportes", new { _uci = "__REPLACE__" })';
                if (query.length >= 3) {
                    $.ajax({
                        url: '@Url.Action("Get_Customer_Search", "Reportes")',
                        data: { term: query },
                        success: function(data) {
                            $('#resultList').empty();
                            if (data.length > 0) {
                                $.each(data, function (index, item) {
                                    var url = baseUrl.replace("__REPLACE__", item.UCI);
                                    var string_append = '<div class="s_box"><button type="button" onclick="AsignarUCI(\'prueba\',' + item.UCI + ')" class="btn_search"><div class="row"><div class="col-3"><i class="bi bi-person-lines-fill s_icon"></i></div><div class="col-9">' + item.Name + ' ' + item.LastName+'</div></div></button></div>';
                                    $('#resultList').append(string_append);
                                   
                                });
                            } else {
                                $('#resultList').append('<li class="list-group-item">No results found</li>');
                            }
                        }
                    });
                } else {
                    $('#resultList').empty();
                }
            });

