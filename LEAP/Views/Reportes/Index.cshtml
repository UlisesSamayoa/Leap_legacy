
@{
    ViewBag.Title = "Reportes";
}

<style>

    .s_box {
        margin: 2px;
        background: #D5DBDB;
        border-radius: 5px;
        padding:2px;
    }
    .btn_search:hover {
        /*background: #B2BABB;*/
        font-size: 17px;
        color: blue;
        font-weight: bold;
        width: 100%;
        margin: 3px;
    }
    .btn_search {
        font-size:16px;
        width: 100%;
        height: 100%;
        background: #D5DBDB;
        border: none;
        margin:3px;
        border-radius:5px;
    }
    #btn_clear {
        display: none;
    }
</style>
<script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
<div class="container">
    <div class="row">
        <div class="col-12 text-center">
            <h2>REPORTES</h2>
        </div>
        <div>
            <h2>search consumer</h2>
            <div class="row">
                <div class="col-12 input-group">
                    <input type="text" id="searchBox" class="form-control" placeholder="Buscar por Nombre o UCI" autocomplete="off">
                    <button class="btn btn-warning" id="btn_clear">Clear</button>
                </div>
                <div class="col-sm-12 col-md-12 col-lg-5">
                    <ul id="resultList" class="list-group mt-2"></ul>
                </div>
            </div>
        </div>
        <input type="text" id="prueba" />
        <ul>
            @*<div class="s_box"><button type="button" onclick="AsignarUCI(\'prueba\',' + item.UCI +')" class="btn_search"><div class="row"><div class="col-3"><i class="bi bi-person-lines-fill s_icon"></i></div><div class="col-9">' + item.Name+'</div></div></button></div>*@
        </ul>
    </div>
