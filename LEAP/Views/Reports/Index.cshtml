<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        GetRegional();
        Getspecialist();
        function GetRegional() {
            $.ajax({
                type: "GET",
                url: "@Url.Action("GetRegionals", "Consumer")",
                data: {},
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                success: function (response) {

                    var data = response.split(";");
                    var haa = data.length - 1;
                    for (var i = 0; i < haa; i++) {
                        var datos = data[i].split(",");
                        document.getElementById("regional").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + "</option>";

                    }

                }
            });
        }

        function Getspecialist() {
            $.ajax({
                type: "GET",
                url: "@Url.Action("Getspecialist", "Consumer")",
                data: {},
                contentType: "application/json; charset=utf-8",
                dataType: "text",
                success: function (response) {
                    var data = response.split(";");
                    var haa = data.length - 1;
                    for (var i = 0; i < haa; i++) {
                        var datos = data[i].split(",");
                        document.getElementById("cds").innerHTML += "<option value='" + datos[0].trim() + "'>" + datos[1] + " " + datos[2] + "</option>";
                        document.getElementById("cdsconsumer").innerHTML += "<option value='" + datos[0].trim() + "'>" + datos[1] + " " + datos[2] + "</option>";
                        document.getElementById("cdsvisits").innerHTML += "<option value='" + datos[0].trim() + "'>" + datos[1] + " " + datos[2] + "</option>";
                    }
                }
            });
        }

    });
</script>