
@model LEAP.Models.ReportsModel
@{
    ViewBag.Title = "Rpt_consumer";
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>

    .s_box {
        margin: 2px;
        background: #D5DBDB;
        border-radius: 5px;
        padding: 2px;
    }

    .btn_search:hover {
        /*background: #B2BABB;*/
        font-size: 17px;
        color: blue;
        font-weight: bold;
        width: 100%;
        margin: 3px;
    }

    .btn_search {
        font-size: 16px;
        width: 100%;
        height: 100%;
        background: #D5DBDB;
        border: none;
        margin: 3px;
        border-radius: 5px;
    }

    #btn_clear {
        display: none;
    }
</style>
<a href="@Url.Action("Index","Reports")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<br />
<h2>Report Details</h2>

<div class="row">
    <div class="row">
        <div class="col-12 input-group">
            <input type="text" id="searchBox" class="form-control" placeholder="Buscar por Nombre o UCI" autocomplete="off">
            <button class="btn btn-warning" id="btn_clear">Clear</button>
        </div>
        <div class="col-sm-12 col-md-12 col-lg-6">
            <ul id="resultList" class="list-group mt-2"></ul>
        </div>
    </div>
    @*<form asp-action="Rpt_consumer" asp-controller="Reports" method="post">*@
    <div class="row">
        <div class="col-6">
            <div class="form-group">
                <label asp-for="UCI">Consumer Name = <b><label id="UCI_N"></label></b></label>
                @*@Html.DropDownListFor(m => m.UCI, ViewBag.VB_Consumer as List<SelectListItem>, " -- Select Consumer --", new { @class = "form-control", required = "true" })*@
                @Html.TextBoxFor(m => m.UCI, new { @class = "form-control", placeholder = "Consumer details", required = "true" })
            </div>
        </div>
        <div class="col-2">
            <div class="form-group">
                <label>Action</label><br />
                @*<button class="btn btn-success" type="submit">Preview</button>*@
                <button class="btn btn-success" id="previewButton">Preview</button>
            </div>
        </div>
    </div>
    @*</form>*@

    <hr />
    <div id="consumerDetailsContainer"></div>

</div>

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="https://unpkg.com/imask"></script>
<script src="~/Scripts/bootstrap.bundle.js"></script>
<script>
    $(document).ready(function () {
        $('#btn_clear').hide();
            $('#searchBox').on('keyup', function() {
                var query = $('#searchBox').val();
                if (query.length > 0) {
                    $('#btn_clear').show();
                } else {
                    $('#btn_clear').hide();
                }
                var baseUrl = '@Url.Action("Consumer_Report", "Reportes", new { _uci = "__REPLACE__" })';
                if (query.length >= 3) {
                $.ajax({
                url: '@Url.Action("Get_Customer_Search", "Reports")',
                data: { term: query },
                success: function(data) {
                $('#resultList').empty();
                if (data.length > 0) {
                $.each(data, function (index, item) {
                var url = baseUrl.replace("__REPLACE__", item.UCI);
                var string_append = '<div class="s_box"><button type="button" onclick="AsignarUCI(\'UCI\',\'' + item.UCI + '\',\''+item.Name+' '+item.LastName+'\')" class="btn_search"><div class="row"><div class="col-3"><i class="bi bi-person-lines-fill s_icon"></i></div><div class="col-9">' + item.Name + ' ' + item.LastName+'</div></div></button></div>';
                $('#resultList').append(string_append);

                });
                } else {
                $('#resultList').append('<li class="list-group-item">No results found</li>');
                }
                }
                });
                } else {
                $('#resultList').empty();
                }
                });
                });

                function AsignarUCI(input, valor,nombre) {
                $("#" + input).val(valor)
                $("#"+input+"_N").text(nombre)
                };

                $('#btn_clear').click(function () {
                $('#searchBox').val('');
                $('#resultList').empty();
                $('#btn_clear').hide();
                });


                $('#previewButton').click(function(event) {
                event.preventDefault();
                var selectedConsumerId = $('#UCI').val();
                if (selectedConsumerId) {
                    $.ajax({
                        url: '@Url.Action("Rpt_CreateNotesConsumer", "Reports")',
                        data: { UCI: selectedConsumerId },
                        success: function(data) {
                            $('#consumerDetailsContainer').html(data);
                        }
                    });
                }

        });
</script>
