<script>
    $(document).ready(function () {
        var dateOfBirth = $("#dob").val();
        $.ajax({
            type: "GET",
            url: 'edad',
            data: { dateOfBirth: dateOfBirth },
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            success: function (response) {
                document.getElementById("age").value = response;
            }
        }); 
    });
</script>