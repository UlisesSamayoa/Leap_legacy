@model List<LEAP.Models.ReportsModel>
@if (Model != null)
{
    <div class="card-body">

        <div class="row">
            <table id="table_NotesC" class="table table-hover" style="width:100%">
                <thead class="thead-dark">
                    <tr>
                        <th>UCI</th>
                        <th>ConsumerName</th>
                        <th>Date</th>
                        <th>Length of Session</th>
                        <th>Notes</th>
                        <th>Active</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var NotesConsumer in Model)
                        {
                            <tr>
                                <td>@NotesConsumer.UCI</td>
                                <td>@NotesConsumer.ConsumerName</td>
                                <td>@NotesConsumer.Date.ToString("MM/dd/yyyy")</td>
                                <td>@NotesConsumer.Duration</td>
                                @if (NotesConsumer.NotesConsumer.Length >= 100)
                                {
                                    <td>@NotesConsumer.NotesConsumer.Substring(0, 100)...</td>
                                }
                                else
                                {
                                    <td>@NotesConsumer.NotesConsumer</td>
                                }
                                <td>@NotesConsumer.Active</td>
                                <td>
                                    <button class="btn btn-warning btn-sm" onclick="abrirArchivoEnNuevaPestana('@NotesConsumer.UCI', '@NotesConsumer.Date.ToString("o")')"><i class="bi bi-printer-fill"></i> Print</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                No data available
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div>
        <h3 class="text-danger">¡ERROR!</h3>
    </div>
}
<script>
    function abrirArchivoEnNuevaPestana(uci, visitDate) {
        // @Url.Action resuelve el virtual path real del sitio en IIS (ej.
        // /NombreWeb/Reports/...) en vez de asumir que la app vive en la raiz
        // del dominio - '/Reports/...' a mano daba 404 en IIS cuando el sitio
        // se publica en una subcarpeta en vez de la raiz.
        const baseUrl = '@Url.Action("NotesConsumerReport", "Reports")';
        const url = baseUrl + '?_uci=' + encodeURIComponent(uci) + '&_date=' + encodeURIComponent(visitDate);

        // Abre una nueva pestaña con la URL generada
        window.open(url, '_blank');
    }
</script>