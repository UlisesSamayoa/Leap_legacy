@model List<LEAP.Models.ReportsModel>
@if (Model != null)
{
    <div class="card-body">

        <div class="row">
            @if (Model != null)
            {
                int cant = 0;
                foreach (var NotesConsumer in Model)
                {
                    cant++;
                    if (cant == 1)
                    {
                        <div class="col-12 text-end">
                            <input type="hidden" value="@NotesConsumer.UCI" asp-for="UCI" id="UCI" />
                            <button class="btn btn-warning" onclick="abrirArchivoEnNuevaPestana()"><i class="bi bi-printer-fill"></i> Print report</button>
                        </div>
                        <br />
                    }
                }

            }

            <table id="table_NotesC" class="table table-hover" style="width:100%">
                <thead class="thead-dark">
                    <tr>
                        <th>UCI</th>
                        <th>ConsumerName</th>
                        <th>Notes</th>
                        <th>Active</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        foreach (var NotesConsumer in Model)
                        {
                            <tr>
                                <td>@NotesConsumer.UCI</td>
                                <td>@NotesConsumer.ConsumerName</td>
                                @if (NotesConsumer.NotesConsumer.Length >= 100)
                                {
                                    <td>@NotesConsumer.NotesConsumer.Substring(0, 100)...</td>
                                }
                                else
                                {
                                    <td>@NotesConsumer.NotesConsumer</td>
                                }
                                <td>@NotesConsumer.Active</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2">
                                No data available
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div>
        <h3 class="text-danger">¡ERROR!</h3>
    </div>
}
<script>
    $(document).ready(function () {
        $("#print_rpt").on("click", function () {
             var uci = $('#UCI').val();
                    $.ajax({
                        url: "@Url.Action("NotesConsumer_Report", "Reports")",
                        data: { _uci: uci },
                        type: "POST",
                        success: function(data) {
                            $('#resultList').empty();
                            if (data.length > 0) {

                            } else {

                            }
                        }
                    });
        });
    });
    function abrirArchivoEnNuevaPestana() {
        var uci = $('#UCI').val();
        // Genera la URL hacia el método en el controlador con el parámetro id
        const url = '/Reports/NotesConsumerReport?_uci=' + uci;
        //const url = '/Reports/NotesConsumer_Report?_uci=' + uci;

        // Abre una nueva pestaña con la URL generada
        window.open(url, '_blank');
    }
</script>