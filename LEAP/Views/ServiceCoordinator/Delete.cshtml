@model LEAP.Models.ServiceCoordinatorModel
@{
    ViewBag.Title = "Delete - Service Coordinator";
}
<a href="@Url.Action("Index","ServiceCoordinator")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<br />
<div class="card">
    @if (Model != null && !Model._ErrorCode)
    {
        <form asp-action="Delete" asp-controller="ServiceCoordinator" asp-route-id="@Model.IDServiceC" method="post">
            @Html.AntiForgeryToken()
            <h5 class="card-header bg-dark text-white">Delete a Service Coordinator</h5>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 text-center alert alert-danger">
                        Are you sure you want to delete the Service Coordinator: @Model.NameC?
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-warning " type="submit"><i class="bi bi-trash-fill"></i> Delete</button>
                <a href="@Url.Action("Index","ServiceCoordinator")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
            </div>
        </form>
    }
    else
    {
        <h3 class="text-danger">Error: this Service Coordinator could not be deleted.</h3>
        <a href="@Url.Action("Index","ServiceCoordinator")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
    }
</div>
