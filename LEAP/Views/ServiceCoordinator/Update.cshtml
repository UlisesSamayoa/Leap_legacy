@model LEAP.Models.ServiceCoordinatorModel
@using Newtonsoft.Json

<style>
    .expandable-textarea {
        width: 100%;
        min-height: 50px;
        max-height: 300px;
        overflow: hidden;
        resize: vertical;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 7px;
        padding: 8px;
    }

        .expandable-textarea:focus {
            outline: none;
            border-color: #ccc;
            box-shadow: 0 0 5px rgba(102, 175, 233, 0.6);
        }
</style>
<a href="@Url.Action("Index","ServiceCoordinator")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<br />
<div class="card">
    @if (Model != null)
    {
        <form asp-action="Update" asp-controller="ServiceCoordinator" asp-route-id="@Model.IDServiceC" method="post">
            <h5 class="card-header bg-dark text-white">Update a Service Coordinator</h5>
            <div class="card-body">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label asp-for="NameC">Service Coordinator name</label>
                    @Html.TextBoxFor(m => m.NameC, new { @class = "form-control", placeholder = "Name input", required = "true" })
                </div>
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label asp-for="IDRegionalcenter">Regional Center</label>
                            <select id="regional" name="Regional" class="form-control" required>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <label asp-for="Tel">Telephone</label>
                            @Html.TextAreaFor(m => m.Tel, new { @class = "form-control", placeholder = "tel input" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary text-white" type="submit"><i class="bi bi-pencil-square"></i> Update</button>
                <a href="@Url.Action("Index","ServiceCoordinator")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
            </div>
        </form>
    }
    else
    {
        <h3 class="text-danger">¡ERROR!</h3>
    }
</div>
<script src="~/Scripts/jquery-3.4.1.js"></script>

<script>
    $(document).ready(function () {
        GetRegional();

        function applyPhoneMask(event) {
            let input = event.target;
            let value = input.value.replace(/\D/g, '');
            if (value.length <= 3) {
                input.value = `(${value}`;
            } else if (value.length <= 6) {
                input.value = `(${value.substring(0, 3)})-${value.substring(3)}`;
            } else {
                input.value = `(${value.substring(0, 3)})-${value.substring(3, 6)}-${value.substring(6, 10)}`;
            }
        }

        const emphoneInput = document.getElementById('Tel');
        emphoneInput.addEventListener('input', applyPhoneMask);
    });

    function GetRegional() {
        var _base_regional = @Html.Raw(JsonConvert.SerializeObject(Model.IDRegionalcenter));
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetRegionals", "ServiceCoordinator")',
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            success: function (response) {
                var data = response.split(";");
                var haa = data.length - 1;
                for (var i = 0; i < haa; i++) {
                    var datos = data[i].split(",").map(item => item.trim());
                    if (_base_regional == datos[0]) {
                        document.getElementById("regional").innerHTML += "<option value='" + datos[0] + "' selected>" + datos[1] + "</option>";
                    } else {
                        document.getElementById("regional").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + "</option>";
                    }
                }
            }
        });
    }
</script>
    