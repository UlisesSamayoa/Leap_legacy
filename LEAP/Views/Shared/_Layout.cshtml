                        <li>@Html.ActionLink("Notes", "Index", "Notes", new { area = "" }, new { @class = "nav-link text-white nav_link" })</li>
                        <li>@Html.ActionLink("RegionalCenter", "Index", "RegionalCenter", new { area = "" }, new { @class = "nav-link text-white nav_link" })</li>
                        <li>@Html.ActionLink("Reports", "Index", "Reportes", new { area = "" }, new { @class = "nav-link text-white nav_link" })</li>
                    </ul>
