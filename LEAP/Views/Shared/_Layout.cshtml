@using System.Security.Claims;
@using LEAP.Data;
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - LEAP</title>

    @*<link href="https://cdn.datatables.net/v/dt/dt-2.0.7/b-3.0.2/datatables.min.css" rel="stylesheet">*@
    @*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">*@
    @*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>*@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @*<script src="https://kit.fontawesome.com/835cb773b4.js" crossorigin="anonymous"></script>*@
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/styles_menu.css" rel="stylesheet" />
    <link href="~/Content/DataTable/datatables.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
</head>
<body>

    <div class="wrapper d-flex align-items-stretch">
        <nav id="sidebar">
            <div class="custom-menu">
                <button type="button" id="sidebarCollapse" class="btn btn-secondary">
                    <i class="bi bi-list"></i>
                </button>
            </div>
            <div class="img bg-wrap text-center py-4">
                
                <div class="user-logo">
                    <a href="@Url.Action("/Index","Home")">
                        <img src="~/Content/Template/leap_logo.png" alt="Leap logo" width="70%" />
                        <br />
                        <label class="text-white">!Welcome @User.Identity.Name!</label>
                    </a>
                </div>
            </div>
            <ul class="list-unstyled components mb-5">

                <li class="active">
                    <a href="@Url.Action("/Index","Home")" class="nav_menu">
                        <i class="bi bi-house-fill fs-6"></i> Home
                    </a>
                </li>
                <li class="active">
                    <a href="@Url.Action("/Index","Events")" class="nav_menu">
                        <i class="bi bi-calendar-plus fs-6"></i> Events
                    </a>
                </li>
                <li class="active">
                    <a href="@Url.Action("/Index","Calendar")" class="nav_menu">
                        <i class="bi bi-calendar-week fs-6"></i> Calendar
                    </a>
                </li>
                <li class="active">
                    <a href="@Url.Action("/Birthdays","Consumer")" class="nav_menu">
                        <i class="bi bi-cake2 fs-6"></i> Birthdays
                    </a>
                </li>
                <li class="active">
                    <a href="@Url.Action("/Index","Reports")" class="nav_menu">
                        <i class="bi bi-file-earmark-medical-fill fs-6"></i> Reports
                    </a>
                </li>
                <li class="active">
                    <a href="@Url.Action("/Index","Consumer")" class="nav_menu">
                        <i class="bi bi-person-vcard-fill fs-6"></i> Consumer
                    </a>
                </li>
                <li class="active">
                    <a href="@Url.Action("/Ready4Archive","Consumer")" class="nav_menu">
                        <i class="bi bi-person-vcard-fill fs-6"></i> Consumer R4A
                    </a>
                </li>
                @if (!AuthContext.IsOperador)
                {
                    <li class="active">
                        <a href="@Url.Action("/Index","RegionalCenter")" class="nav_menu">
                            <i class="bi bi-house-gear-fill fs-6"></i> RegionalCenter
                        </a>
                    </li>
                    <li class="active">
                        <a href="@Url.Action("/Index","Languajes")" class="nav_menu">
                            <i class="bi bi-translate fs-6"></i> Languages
                        </a>
                    </li>
                    <li class="active">
                        <a href="@Url.Action("/Index","Cities")" class="nav_menu">
                            <i class="bi bi-globe-americas fs-6"></i> Cities
                        </a>
                    </li>
                }
                <li class="active">
                    <a href="@Url.Action("/Index","Authorization")" class="nav_menu">
                        <i class="bi bi-person-fill-check fs-6"></i> Authorization
                    </a>
                </li>
                @if (!AuthContext.IsOperador)
                {
                    <li class="active">
                        <a href="@Url.Action("/Index","ServiceCoordinator")" class="nav_menu">
                            <i class="bi bi-journal-bookmark-fill fs-6"></i> Coordinators
                        </a>
                    </li>
                }
                <li class="active">
                    <a href="@Url.Action("/Index","NotesxConsumer")" class="nav_menu">
                        <i class="bi bi-journal-bookmark-fill fs-6"></i> Notes x Consumer
                    </a>
                </li>
                <li class="active">
                    <a href="@Url.Action("/Index","notesxmaestro")" class="nav_menu">
                        <i class="bi bi-journal-bookmark-fill fs-6"></i> Notes x Teacher
                    </a>
                </li>
                <li class="active">
                    <a href="@Url.Action("/Archived","Consumer")" class="nav_menu">
                        <i class="bi bi-journal-album fs-6"></i>  Archived
                    </a>
                </li>
                @if (!AuthContext.IsOperador)
                {
                    <li class="active">
                        <a href="@Url.Action("/Index","Specialist")" class="nav_menu">
                            <i class="bi bi-person-vcard-fill fs-6"></i> Specialist
                        </a>
                    </li>
                }
                <li class="active">
                    <a href="@Url.Action("/Index","EventType")" class="nav_menu">
                        <i class="bi bi-calendar2-range-fill fs-6"></i> EventType
                    </a>
                </li>
                @if (!AuthContext.IsOperador)
                {
                    <li class="active">
                        <a href="@Url.Action("/Index","Users")" class="nav_menu">
                            <i class="bi bi-people-fill fs-6"></i> Users
                        </a>
                    </li>
                }
                <li class="active">
                    <a href="@Url.Action("/Logout","Login")" class="nav_menu">
                        <i class="bi bi-box-arrow-right fs-6"></i> Log out
                    </a>
                </li>
            </ul>
        </nav>

        <div id="content" class="p-4 p-md-5 pt-5">
            <div class="container body-content">
                @RenderBody()
                <hr />
                <footer>
                    <p>&copy; @DateTime.Now.Year - Mauricio Gudiel</p>
                </footer>
            </div>
        </div>
    </div>

    @*<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark nav_bg_color">
            <div class="container">
                @Html.ActionLink("LEAP", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
