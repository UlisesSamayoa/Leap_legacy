@model LEAP.Models.SpecialistModel
@{
    ViewBag.Title = "Delete - Specialist";
}
<a href="@Url.Action("Index","Specialist")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<br />
<div class="card">
    @if (Model != null && !Model._ErrorCode)
    {
        <form asp-action="Delete" asp-controller="Specialist" asp-route-lg="@Model.IDSpecialist" method="post">
            @Html.AntiForgeryToken()
            <h5 class="card-header bg-dark text-white">Delete a Specialist</h5>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 text-center alert alert-danger">
                        Are you sure you want to delete the Specialist: @Model.Name @Model.LastName?
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-warning " type="submit"><i class="bi bi-trash-fill"></i> Delete</button>
                <a href="@Url.Action("Index","Specialist")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
            </div>
        </form>
    }
    else
    {
        <h3 class="text-danger">Error: this Specialist could not be deleted. It may still be linked to a user or to visit reports.</h3>
        <a href="@Url.Action("Index","Specialist")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
    }
</div>