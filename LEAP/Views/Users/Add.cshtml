@model LEAP.Models.UsersModel
@{
    ViewBag.Title = "Add User";
}
<div class="card">
    <form action="@Url.Action("AddUsers","Users")" method="post">
        <h5 class="card-header bg-dark text-white">Add a User</h5>
        <div class="card-body">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-4">
                    <div class="form-group">
                        <label asp-for="Name">Name</label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Name", required = "true" })
                    </div>
                </div>
                <div class="col-5">
                    <div class="form-group">
                        <label asp-for="Notes">Last name</label>
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "LastMame", required = "true" })
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <label asp-for="Notes">DOB</label>
                        @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control", required = "true", type = "date" })
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <label asp-for="Name">User</label>
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "User", required = "true" })
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <label asp-for="Notes">Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email", required = "true", type = "email" })
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <label asp-for="Name">Phone</label>
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", placeholder = "Phone", required = "true", id = "phone" })
                    </div>
                </div>
                <div class="col-3">
                    <div class="form-group">
                        <label asp-for="Type_User" name="Type_User">Type</label>
                        @Html.DropDownListFor(
                            model => model.Type_User,
                            new SelectList(
                                new[] { new { Value = "1", Text = "Administrator" }, new { Value = "2", Text = "Operator" } },
                                "Value", "Text"),
                            "Select Type",
                            new { @class = "form-control", id = "Type_User" }
                        )
                    </div>
                </div>
                <div class="col-3" id="specialistGroup" style="display:none;">
                    <div class="form-group">
                        <label asp-for="SpecialistId">Specialist (CDS)</label>
                        @Html.DropDownListFor(
                            model => model.SpecialistId,
                            new SelectList(new List<object>(), "Value", "Text"),
                            "Choose an option...",
                            new { @class = "form-control", id = "SpecialistId" }
                        )
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label asp-for="Password" name="Password">Password</label>
                            <div class="input-group">
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter Password", required = "true", id = "password" })
                                <button type="button" class="btn btn-secondary" id="togglePassword">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="form-group">
                            <label for="confirmPassword">Confirm Password</label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="confirmPassword" placeholder="Confirm Password" required>
                                <button type="button" class="btn btn-secondary" id="toggleConfirmPassword"><i class="bi bi-eye-fill"></i></button>
                            </div>
                        </div>
                    </div>
                </div>


