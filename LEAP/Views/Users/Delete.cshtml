@model LEAP.Models.UsersModel
@{
    ViewBag.Title = "Delete - User";
}
<a href="@Url.Action("Index","Users")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<br />
<div class="card">
        <form action="@Url.Action("DeleteUser","Users", new { id = Model.IDUsers })" method="post">
            @Html.AntiForgeryToken()
            <h5 class="card-header bg-dark text-white">Delete a Languaje</h5>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 text-center alert alert-danger">
                        Are you sure you want to delete the Users: <b> @Model.Name @Model.LastName </b>?
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-warning " type="submit"><i class="bi bi-trash-fill"></i> Delete</button>
                <a href="@Url.Action("Index","Users")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
            </div>
        </form>
</div>