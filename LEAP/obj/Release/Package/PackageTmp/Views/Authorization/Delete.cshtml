@model LEAP.Models.AuthorizationModel
@{
    ViewBag.Title = "Delete - Authorization";
}
@if (Model != null)
{
    if (Model.type == 0)
    {
        <a href="@Url.Action("Index","Authorization")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
        <br />
        <br />
    }
    else
    {

    }
}
@*<a href="@Url.Action("Index","Authorization")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
    <br />
    <br />*@
<div class="card">
    <form asp-action="Delete" asp-controller="Authorization" asp-route-id="@Model.IDAuth" method="post">
        @Html.AntiForgeryToken()
        <h5 class="card-header bg-dark text-white">Delete a Authorization</h5>
        <div class="card-body">
            <div class="row">
                @if (ViewBag.VB_error != null)
                {
                    <p class="bg-success text-white" style="padding:5px; border-radius:5px;"> Authorization delete successfully, reload the list in Consumer</p>
                    <script>
                        setTimeout(() => {
                            window.close()
                        }, 2000);
                    </script>
                }
                <div class="col-1">

                </div>
                <div class="col-10 text-center alert alert-danger">
                    Are you sure you want to delete the Authorization: @Model.auth for the consumer @Model.ConsumerName in the period: @Model._From_s to @Model._To_s?
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-warning " type="submit"><i class="bi bi-trash-fill"></i> Delete</button>
            <a href="@Url.Action("Index","Authorization")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
        </div>
    </form>
</div>