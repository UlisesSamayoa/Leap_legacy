@model LEAP.Models.CitiesModel
@{
    ViewBag.Title = "Update - Cities";
}
<a href="@Url.Action("Index","Cities")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<br />
<div class="card">
    <form asp-action="Update" asp-controller="Cities" asp-route-id="@Model.IDCity" method="post">
        <h5 class="card-header bg-dark text-white">Update a City</h5>
        <div class="card-body">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="City">City name</label>
                @Html.TextBoxFor(m => m.City, new { @class = "form-control", placeholder = "Name input", required = "true" })
            </div>
            <div class="form-group">
                <label asp-for="State">State name</label>
                @Html.TextBoxFor(m => m.State, new { @class = "form-control", placeholder = "Name input", required = "true" })
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-primary text-white" type="submit"><i class="bi bi-pencil-square"></i> Update</button>
            <a href="@Url.Action("Index","Cities")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
        </div>
    </form>
</div>
<script src="~/Scripts/jquery-3.4.1.js"></script>