@model LEAP.Models.EventTypeModel
@{
    ViewBag.Title = "Delete - EventType";
}
<a href="@Url.Action("Index","EventType")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
<br />
<br />
<div class="card">
    <form asp-action="Delete" asp-controller="EventType" asp-route-lg="@Model.IDEventType" method="post">
        @Html.AntiForgeryToken()
        <h5 class="card-header bg-dark text-white">Delete a Specialist</h5>
        <div class="card-body">
            <div class="row">
                <div class="col-12 text-center alert alert-danger">
                    Are you sure you want to delete the EventType: @Model.Title?
                    <br />
                    <br />
                    Color:
                    <div style="background:@Model.Color;">
                        <br />
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            @*<button class="btn btn-warning " type="submit"><i class="bi bi-trash-fill"></i> Delete</button>*@
            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="bi bi-trash-fill"></i> Delete
            </button>
            <a href="@Url.Action("Index","EventType")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
        </div>
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger">
                    <h5 class="modal-title text-white" id="deleteModalLabel">Confirm this action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    This action will delete the events bound to the EventType, are you sure to continue?
                    <br />
                    <div class="text-center">
                        <label class="text-center">EventType: @Model.Title</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger" id="confirmDeleteBtn">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
    </form>
</div>