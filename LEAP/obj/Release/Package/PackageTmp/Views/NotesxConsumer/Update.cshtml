@model LEAP.Models.NotesxConsumerModel
@{
    ViewBag.Title = "Update - NotesXConsumer";
}
<style>
    .expandable-textarea {
        width: 100%;
        min-height: 300px;
        overflow: hidden;
        resize: vertical;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 7px;
        padding: 8px;
    }

        .expandable-textarea:focus {
            outline: none;
            border-color: #ccc;
            box-shadow: 0 0 5px rgba(102, 175, 233, 0.6);
        }
</style>
@if (Model != null)
{
    if (Model.type == 0)
    {
        <a href="@Url.Action("Index", "NotesxConsumer")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
        <br />
        <br />
    }
    else
    {

    }
}

    <div class="card">
        @if (Model != null)
        {
            <form asp-action="Update" asp-controller="NotesxConsumer" asp-route-id="@Model.IDNotesxConsumer" method="post">
                <h5 class="card-header bg-dark text-white">Update a NotesxConsumer</h5>
                <div class="card-body">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        @if (ViewBag.VB_error != null)
                        {       
                        <p class="bg-success text-white" style="padding:5px; border-radius:5px;"> Note update successfully, reload the list in Consumer</p>
                            <script>
                                setTimeout(() => {
                                    window.close()
                                }, 2000);
                            </script>
                        }
                        <div class="col-6">
                            <div class="form-group">
                                <label for="UCI">Consumer Name <b><label id="UCI_N"></label></b></label>
                                @*@Html.DropDownListFor(m => m.UCI, ViewBag.VB_Consumer as List<SelectListItem>, " -- Select Consumer --", new { @class = "form-control", required = "true" })*@
                                @Html.TextBoxFor(m => m.UCI, new { @type = "hidden", @class = "form-control", placeholder = "Consumer details", required = "true" })
                                @Html.TextBoxFor(m => m.type, new { @type = "hidden", @class = "form-control", placeholder = "Type" })
                                @Html.TextBoxFor(m => m.ConsumerName, new { @class = "form-control", placeholder = "Consumer details", required = "true", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-group">
                                <label for="Active">Active</label>
                                @Html.DropDownListFor(model => model.Active, new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "Enabled", Value = "true" },
                                    new SelectListItem { Text = "Disabled", Value = "false" }
                                }, "-- Select Status --", new { @class = "form-control", required = "true" })
                                @Html.ValidationMessageFor(model => model.Active)
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-group">
                                <label for="Notes">Notes</label>
                                @Html.TextAreaFor(m => m.Notes, new { @class = "expandable-textarea", placeholder = "Notes input", required = "true" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-primary text-white" type="submit"><i class="bi bi-pencil-square"></i> Update</button>
                    @if (Model.type == 0)
                    {
                        <a href="@Url.Action("Index","NotesxConsumer")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
                    }
                    else
                    {
                        <a onclick="window.close();" class="btn btn-danger text-white"><i class="bi bi-x-square-fill"></i> Cancel</a>
                    }

                </div>
            </form>
        }
        else
        {
            <h3 class="text-danger">¡ERROR!</h3>
        }
    </div>
    <script src="~/Scripts/jquery-3.4.1.js"></script>

