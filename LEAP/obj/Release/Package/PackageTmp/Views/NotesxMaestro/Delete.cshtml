@model LEAP.Models.NotesxMaestroModel
@{
    ViewBag.Title = "Delete - NotesxMaestro";
}
<style>
    .expandable-textarea {
        width: 100%;
        height: 200px;
        min-height: auto;
        resize: vertical;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 7px;
        padding: 8px;
        /*Style para desactivar la textarea*/

        user-select: none;
        background-color: #ccc;
    }

        .expandable-textarea:focus {
            outline: none;
            border-color: #ccc;
            box-shadow: 0 0 5px rgba(102, 175, 233, 0.6);
        }
</style>
@if (Model != null)
{
    if (Model.type == 0)
    {
        <a href="@Url.Action("Index","NotesxMaestro")" class="btn btn-danger"><i class="bi bi-box-arrow-in-left"></i> Go Back</a>
        <br />
        <br />
    }
}
<div class="card">
    @if (Model != null)
    {
        <form asp-action="Delete" asp-controller="NotesxMaestro" asp-route-id="@Model.IDNotesxMaestro" method="post">
            @Html.AntiForgeryToken()
            <h5 class="card-header bg-dark text-white">Delete a NotesxMaestro</h5>
            <div class="card-body">
                <div class="row">
                    <div class="col-12 text-center alert alert-danger">
                        Are you sure you want to delete the Note for the Consumer with UCI: @Model.UCI and Name: @Model.ConsumerName?
                        @Html.TextBoxFor(m => m.type, new { @type = "hidden", @class = "form-control", placeholder = "Type" })
                    </div>
                    <div class="col-12">
                        <label>*********Note Details</label>

                        <textarea class="expandable-textarea" readonly>
                    @Model.Notes
                    </textarea>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-warning " type="submit"><i class="bi bi-trash-fill"></i> Delete</button>
                @if (Model.type == 0)
                {
                    <a href="@Url.Action("Index","NotesxMaestro")" class="btn btn-danger"><i class="bi bi-x-square-fill"></i> Cancel</a>
                }
                else
                {
                    <a onclick="window.close();" class="btn btn-danger text-white"><i class="bi bi-x-square-fill"></i> Cancel</a>
                }
                
            </div>
        </form>
    }
    else
    {
        <h3 class="text-danger">¡ERROR!</h3>
    }
</div>