<script>

    $(document).ready(function () {


        function applyPhoneMask(event) {
            let input = event.target;
            let value = input.value.replace(/\D/g, '');
            if (value.length <= 3) {
                input.value = `(${value}`;
            } else if (value.length <= 6) {
                input.value = `(${value.substring(0, 3)})-${value.substring(3)}`;
            } else {
                input.value = `(${value.substring(0, 3)})-${value.substring(3, 6)}-${value.substring(6, 10)}`;
            }
        }
        const phoneInput = document.getElementById('phone');
        phoneInput.addEventListener('input', applyPhoneMask);
        const emphoneInput = document.getElementById('emphone');
        emphoneInput.addEventListener('input', applyPhoneMask);


        GetRegional();

        GetCity();
        Getspecialist();

        
        $.ajax({
            type: "GET",
            url: '/Consumer/Getspecialist',
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            success: function (response) {
                var data = response.split(";");
                var haa = data.length - 1;
                for (var i = 0; i < haa; i++) {
                    var datos = data[i].split(",");
                    document.getElementById("TeacherSpecialist").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + " " + datos[2] + "</option>";

                }

            }
        });

        
    })


    function GetCity() {
        var _base_city = @Model.CityID
            $.ajax({
            type: "GET",
            url: "@Url.Action("Getcities","Consumer")",
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            success: function (response) {

                var data = response.split(";");
                var haa = data.length - 1;
                for (var i = 0; i < haa; i++) {
                    /*var datos = data[i].split(",");*/
                    var datos = data[i].split(",").map(item => item.trim());
                    if (_base_city == datos[0]) {
                        document.getElementById("city").innerHTML += "<option value='" + datos[0] + "' selected>" + datos[1] + "</option>";
                    } else {
                        document.getElementById("city").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + "</option>";
                    }


                }

            }
        });
    }
