    function GetRegional() {
        var _base_regional = @Model.RegionalID
            $.ajax({
            type: "GET",
            url: "@Url.Action("GetRegionals", "Consumer")",
            data: {},
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            success: function (response) {
                var data = response.split(";");
                var haa = data.length - 1;
                for (var i = 0; i < haa; i++) {
                    var datos = data[i].split(",");
                    if (_base_regional == datos[0]) {
                        document.getElementById("regional").innerHTML += "<option value='" + datos[0] + "' selected>" + datos[1] + "</option>";
                        AddressChange(datos[0])
                    } else {
                        document.getElementById("regional").innerHTML += "<option value='" + datos[0] + "'>" + datos[1] + "</option>";
                    }
                }
                }
            });

    }
    function AddressChange(idRegional) {
        var _baseServiCoor = @Model.ServiceCoordinator
        var id = ""
        if (idRegional == "") {
            var id = idRegional
        } else {
            var id = $("#regional option:selected").val();
        }
        $.ajax({
            type: "GET",
            url: "@Url.Action("GetRegionalByID", "Consumer")",
            data: { id: id },
            contentType: "application/json; charset=utf-8",
            dataType: "text",
            success: function (response) {

                var data = response.split(";");
                var haa = data.length - 1;
                for (var i = 0; i < haa; i++) {
                    var datos = data[i].split("|");

                    document.getElementById("phoneReg").value = datos[6];
                    document.getElementById("addressReg").value = datos[2] + ", " + datos[3] + ", " + datos[4] + ", " + datos[5];
                    document.getElementById("tel").value = datos[7];
                    /*document.getElementById("serviceC").value = datos[8];*/
                    document.getElementById("tel").value = datos[8];
                    if (_baseServiCoor == datos[9]) {
                        document.getElementById("serviceC").innerHTML += "<option value='" + datos[9] + "' selected>" + datos[7] + "</option>";
                    } else {
                        document.getElementById("serviceC").innerHTML += "<option value='" + datos[9] + "'>" + datos[7] + "</option>";
                    }
                }


            }
        });
    }


    
