@model List<LEAP.Models.UsersModel>
@{
    ViewBag.Title = "Users";
}
<div class="card">
    <h5 class="card-header bg-dark text-white">Users</h5>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <a href="@Url.Action("Add","Users")" class="btn btn-success text-white">
                    <i class="bi bi-database-fill-add"></i> New
                </a>
                <hr />
                <table id="table_languages" class="table table-hover" style="width:100%">
                    <thead class="thead-dark">
                        <tr>
                            <th>Name</th>
                            <th>LastName</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>UserName</th>
                            <th>Password</th>
                            <th>Update</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null || Model.Count > 0)
                        {
                            foreach (var Users in Model)
                            {
                        <tr>
                            <td>@Users.Name</td>
                            <td>@Users.LastName</td>
                            <td>@Users.Phone</td>
                            <td>@Users.Email</td>
                            <td>@Users.UserName</td>
                            <td>
                                <a class="btn btn-outline-secondary" href="@Url.Action("Change","Users", new { id = Users.IDUsers })"><i class="bi bi-arrow-repeat"></i> Change</a>
                            </td>
                            <td>
                                <a class="btn btn-outline-primary" href="@Url.Action("Update","Users", new { id = Users.IDUsers })"><i class="bi bi-pencil-square"></i> Update</a>
                            </td>
                            @if (Users._Default == true)
                            {
                                <td>
                                    <a class="btn btn-outline-danger disabled" href="#"><i class="bi bi-trash-fill"></i> Delete</a>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <a class="btn btn-outline-danger" href="@Url.Action("Delete","Users", new { id = Users.IDUsers })"><i class="bi bi-trash-fill"></i> Delete</a>
                                </td>
                            }

                        </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2">
                                    No data available
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script>
        $(document).ready(function () {
            $('#table_languajes').DataTable({
                "dom": 'Bfrtip',
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>',
                        title: 'Languajes',
                        filename: 'rpt_languajes',
                        exportOptions: { columns: [0, 1] },
                        className: 'btn_excel'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="bi bi-file-pdf-fill fs-5"></i>',
                        title: 'Languajes',
                        filename: 'rpt_languajes',
                        exportOptions: { columns: [0, 1] },
                        className: 'btn_pdf'
                    }, {
                        extend: 'print',
                        text: '<i class="bi bi-printer-fill fs-5"></i>',
                        title: 'Languajes',
                        filename: 'rpt_languajes',
                        exportOptions: { columns: [0, 1] },
                        className: 'btn_print'
                    }
                ]
            });
        });
    </script>
}
